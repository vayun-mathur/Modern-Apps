<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- No network, deliberately: local notes only. :library:image merges in
         INTERNET (its HttpFetcher) and ACCESS_NETWORK_STATE, neither
         of which this app uses, so both are stripped here like music/ does. -->
    <!-- MAOS: opt out of the GrapheneOS Sensors permission (OTHER_SENSORS). -->
    <!-- This app uses no motion/environment sensors; MAOS withholds the -->
    <!-- Sensors permission at install instead of auto-granting it. -->
    <uses-permission android:name="com.vayunmathur.permission.SENSORS_OPTOUT" />

    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <permission
        android:name="com.vayunmathur.notes.permissions.ACCESS_NOTES"
        android:protectionLevel="signature" />

    <!-- Relay IPC for the everysync app's NoteSink. Signature-level: only apps signed
        with the Modern Apps key can hold it, and the provider additionally narrows the
        caller to com.vayunmathur.everysync at runtime. -->
    <permission
        android:name="com.vayunmathur.notes.permission.RELAY"
        android:protectionLevel="signature" />

    <application
        android:allowBackup="true"
        android:backupAgent=".platform.AppBackupAgent"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.General">
        <activity
            android:configChanges="mcc|mnc|colorMode|density|fontScale|fontWeightAdjustment|keyboard|keyboardHidden|layoutDirection|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.General">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/x-markdown" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/x-markdown" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="application/octet-stream" />
                <data android:pathSuffix=".md" />
                <data android:pathSuffix=".markdown" />
                <data android:pathPattern=".*\\.md" />
                <data android:pathPattern=".*\\.markdown" />
            </intent-filter>
        </activity>

        <activity
            android:name=".intents.GetIntent"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay"
            android:permission="com.vayunmathur.notes.permissions.ACCESS_NOTES">
        </activity>

        <activity
            android:name=".intents.InsertIntent"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay"
            android:permission="com.vayunmathur.notes.permissions.ACCESS_NOTES">
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.vayunmathur.notes.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <provider
            android:name=".sync.RelayNoteProvider"
            android:authorities="com.vayunmathur.notes.relay"
            android:exported="true"
            android:readPermission="com.vayunmathur.notes.permission.RELAY"
            android:writePermission="com.vayunmathur.notes.permission.RELAY" />
    </application>

</manifest>