<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- App name displayed in launcher -->
    <string name="app_name">Global eSIM</string>

    <!-- HomeScreen: Purchase tab title in the app scaffold. Noun. -->
    <string name="purchase_title">Purchase</string>
    <!-- HomeScreen: Heading shown after a payment while the eSIM is being created. -->
    <string name="payment_received">Payment received</string>
    <!-- HomeScreen: Body under payment_received; the page refreshes itself. -->
    <string name="creating_esim">Creating your eSIM. This page updates on its own.</string>
    <!-- HomeScreen: Messenger message when no app can handle the eSIM install intent. -->
    <string name="no_esim_installer">This phone doesn\'t have the eSIM installer.</string>
    <!-- HomeScreen: Button that hands the activation code to the system eSIM installer. Verb phrase. -->
    <string name="install_esim">Install eSIM</string>
    <!-- HomeScreen: Messenger message after the SIM ID is copied to the clipboard. -->
    <string name="sim_id_copied">SIM ID copied. Paste it into Claim on your new phone.</string>
    <!-- HomeScreen: Button that copies the SIM ID to the clipboard. Verb phrase. -->
    <string name="copy_sim_id">Copy SIM ID</string>
    <!-- ClaimCard/HomeScreen: Label for the SIM ID field and clipboard clip. Noun, keep uppercase ID. -->
    <string name="sim_id">SIM ID</string>
    <!-- HomeScreen SetupTerms: Headline for a phone with no eSIM yet. -->
    <string name="setup_headline">One global eSIM for 200+ countries</string>
    <!-- HomeScreen SetupTerms: Subtitle under setup_headline. KYC is know-your-customer verification. -->
    <string name="setup_subtitle">Pay as you go, credit never expires. No email, phone number or KYC.</string>
    <!-- HomeScreen SetupTerms: One-time setup fee line. $3 is the fee amount in USD. -->
    <string name="setup_fee_title">$3 one-time setup fee</string>
    <!-- HomeScreen SetupTerms: Detail under setup_fee_title. $5/$2 are USD amounts. -->
    <string name="setup_fee_detail">Taken from your first top-up ($5 minimum). A $5 top-up leaves $2 of credit.</string>
    <!-- HomeScreen BalanceSummary: Balance caption. %1$s is the status label, e.g. Active. -->
    <string name="balance_with_status">Balance · %1$s</string>
    <!-- HomeScreen BalanceSummary: Balance caption for a stale (last known) balance. %1$s is the status label. -->
    <string name="balance_with_status_last_known">Balance · %1$s · last known</string>
    <!-- HomeScreen BalanceSummary: Pending credit note. %1$s is the formatted amount, e.g. $5.00. -->
    <string name="pending_credit_on_its_way">%1$s on its way. No need to pay again.</string>
    <!-- HomeScreen statusLabel: Display label for the pending profile status. -->
    <string name="status_activating">Activating</string>
    <!-- HomeScreen statusLabel: Display label for the active profile status. -->
    <string name="status_active">Active</string>
    <!-- HomeScreen statusLabel: Display label for the suspended profile status. -->
    <string name="status_paused">Paused</string>
    <!-- HomeScreen statusLabel: Display label for the terminated profile status. -->
    <string name="status_terminated">Terminated</string>
    <!-- HomeScreen statusLabel: Display label while the unknown profile status is being checked. -->
    <string name="status_checking">Checking…</string>

    <!-- PricingScreen: Placeholder of the country search field. Verb phrase. -->
    <string name="search_countries">Search countries</string>
    <!-- PricingScreen: Empty-state title when no rates are loaded and no search is active. -->
    <string name="no_rates_yet">No rates yet</string>
    <!-- PricingScreen: Empty-state message when rates failed to load. -->
    <string name="rates_load_failed">Rates couldn\'t be loaded.</string>
    <!-- PricingScreen: Empty-state title when the search has no matches. -->
    <string name="no_matches">No matches</string>
    <!-- PricingScreen: Empty-state hint under no_matches. -->
    <string name="no_matches_hint">Try another country name or code.</string>
    <!-- PricingScreen: Collapsed country price line. %1$s is the formatted price, e.g. $1.00. GB is gigabyte, do not translate the unit abbreviation. -->
    <string name="price_from_per_gb">from %1$s / GB</string>
    <!-- PricingScreen: Per-carrier price line. %1$s is the formatted price, e.g. $1.00. -->
    <string name="price_per_gb">%1$s / GB</string>
    <!-- PricingScreen: Fallback line when no carrier breakdown is available. %1$s is the formatted price, e.g. $1.00. -->
    <string name="carrier_breakdown_unavailable">Carrier breakdown unavailable — charged at %1$s / GB.</string>

    <!-- TopUpCard: Label of the custom top-up amount field. USD is the currency code. -->
    <string name="topup_amount_label">Top up amount (USD)</string>
    <!-- TopUpCard: Error when the amount cannot be parsed. 10 and 12.50 are example amounts. -->
    <string name="topup_invalid_amount">Enter an amount like 10 or 12.50.</string>
    <!-- TopUpCard: Error when the amount is below the minimum. %1$s is the formatted minimum, e.g. $5.00. -->
    <string name="topup_minimum_payment">Minimum %1$s payment.</string>
    <!-- TopUpCard: Error when the amount is above the maximum. %1$s is the formatted maximum, e.g. $20.00. -->
    <string name="topup_max_payment">%1$s max payment.</string>
    <!-- TopUpCard: Button that starts a card top-up. Noun phrase. -->
    <string name="card_topup">Card topup</string>
    <!-- TopUpCard: Button that starts a crypto top-up. Noun phrase. -->
    <string name="crypto_topup">Crypto topup</string>
    <!-- TopUpCard: Button that reopens the pending crypto checkout. Verb phrase. -->
    <string name="reopen_checkout">Reopen checkout</string>

    <!-- ClaimCard: Prompt above the SIM ID field. -->
    <string name="claim_title">Already have an eSIM on another phone?</string>
    <!-- ClaimCard: Button that claims the entered SIM ID on this phone. Verb phrase. -->
    <string name="claim_action">Claim on this phone</string>

    <!-- CardPaymentSheet: Pay heading/button. %1$s is the formatted amount, e.g. $10.00. -->
    <string name="pay_amount">Pay %1$s</string>
    <!-- CardPaymentSheet: Subtitle under the pay heading. -->
    <string name="card_credit_hint">Credit lands in your eSIM wallet shortly.</string>
    <!-- CardPaymentSheet: Label of the card number field. Noun phrase. -->
    <string name="card_number_label">Card number</string>
    <!-- CardPaymentSheet: Label of the expiry field. Noun. -->
    <string name="expiry_label">Expiry</string>
    <!-- CardPaymentSheet: Placeholder format hint for the expiry field. MM/YY are month/year placeholders, keep the format. -->
    <string name="expiry_placeholder">MM/YY</string>
    <!-- CardPaymentSheet: Label of the security-code field. CVC is the card verification code abbreviation, keep uppercase. -->
    <string name="cvc_label">CVC</string>
    <!-- CardPaymentSheet: Pay button label while payment is being confirmed. -->
    <string name="confirming">Confirming…</string>
</resources>
