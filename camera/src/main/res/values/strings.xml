<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- App name displayed in launcher -->
    <string name="app_name">Camera</string>

    <!-- Main camera: mode selector at bottom (Photo / Video / Portrait etc) -->
    <string name="mode_photo">Photo</string>
    <string name="mode_portrait">Portrait</string>
    <string name="mode_panorama">Pano</string>
    <string name="mode_photosphere">Sphere</string>
    <string name="mode_video">Video</string>
    <string name="mode_slo_mo">Slo-Mo</string>
    <string name="mode_cinematic">Cinematic</string>
    <string name="mode_timelapse">Timelapse</string>
    <!-- TopBar / Auto night: night mode button shown in low light -->
    <string name="night">Night</string>

    <!-- TopBar: flash cycle states -->

    <!-- TopBar / ShutterRow controls -->
    <!-- ShutterRow: thumbnail button that opens last photo in gallery. Noun. Accessibility label -->
    <string name="open_gallery">Gallery</string>

    <!-- Permissions -->
    <!-- Full-screen permission gate when CAMERA and RECORD_AUDIO not granted -->
    <string name="grant_camera_permission">Grant Camera Permission</string>

    <!-- TopBar settings strip: timer, aspect ratio, flash categories -->

    <!-- Aspect ratio -->
    <!-- Setting category and TopBar contentDescription for aspect ratio picker -->
    <string name="settings_aspect_ratio">Aspect Ratio</string>

    <!-- Flash setting category in settings row -->

    <!-- Location / Geotagging settings -->
    <!-- SettingsPage: section title for location tagging -->
    <string name="settings_location">Location</string>
    <!-- SettingsPage: summary explaining save location in EXIF metadata -->
    <string name="settings_location_description">Save location in photo metadata</string>

    <!-- SettingsPage: section title for selfie (front camera) mirroring -->
    <string name="settings_mirror_front">Selfie mirroring</string>
    <!-- SettingsPage: summary explaining front-camera mirroring toggle -->
    <string name="settings_mirror_front_description">Mirror the front camera preview and saved selfies</string>

    <!-- Post-processing toggles (SettingsPage, issue #662) -->
    <!-- SettingsPage: section title for noise-reduction toggle -->
    <string name="settings_noise_reduction">Noise reduction</string>
    <!-- SettingsPage: summary explaining noise-reduction toggle -->
    <string name="settings_noise_reduction_description">Soften noise in photos and video (turn off for raw detail)</string>
    <!-- SettingsPage: section title for edge-sharpening toggle -->
    <string name="settings_edge_sharpening">Edge sharpening</string>
    <!-- SettingsPage: summary explaining edge-sharpening toggle -->
    <string name="settings_edge_sharpening_description">Sharpen edges in photos and video (turn off for a natural look)</string>

    <!-- Video codec settings (SettingsPage) -->
    <!-- SettingsPage: section header for video codec selection -->
    <string name="settings_video_codec">Video codec</string>
    <!-- Video codec option label: H.264 / AVC -->
    <string name="codec_avc_label">H.264 / AVC</string>
    <!-- Video codec description: most compatible, explain compatibility trade-off -->
    <string name="codec_avc_description">Most compatible</string>
    <!-- Video codec option label: H.265 / HEVC -->
    <string name="codec_hevc_label">H.265 / HEVC</string>
    <!-- Video codec description: more efficient than AVC -->
    <string name="codec_hevc_description">More efficient</string>
    <!-- Video codec option label: AV1 -->
    <string name="codec_av1_label">AV1</string>
    <!-- Video codec description: most efficient but may not be supported everywhere -->
    <string name="codec_av1_description">Most efficient</string>

    <!-- Motion-Photo duration settings (SettingsPage, issue #712) -->
    <!-- SettingsPage: section header for motion-photo clip-length selection -->
    <string name="settings_motion_duration">Motion photo length</string>
    <!-- Motion-Photo duration: 1-second clip. %1$d = seconds -->
    <string name="motion_duration_1s">%1$d second</string>
    <!-- Motion-Photo duration: multi-second clip. %1$d = seconds -->
    <string name="motion_duration_ns">%1$d seconds</string>

    <!-- Audio input source settings (SettingsPage): mic source used for video recordings -->
    <!-- SettingsPage: section header for audio input source selection -->
    <string name="settings_audio_source">Audio input source</string>
    <!-- Audio source option label: camcorder (default, tuned for video) -->
    <string name="audio_source_camcorder_label">Camcorder</string>
    <!-- Audio source description: default mic tuned for video recording -->
    <string name="audio_source_camcorder_description">Default, tuned for video</string>
    <!-- Audio source option label: main microphone -->
    <string name="audio_source_mic_label">Microphone</string>
    <!-- Audio source description: the device's main microphone -->
    <string name="audio_source_mic_description">Main microphone</string>
    <!-- Audio source option label: voice communication -->
    <string name="audio_source_voice_communication_label">Voice</string>
    <!-- Audio source description: noise and echo cancellation, good for speaking to camera -->
    <string name="audio_source_voice_communication_description">Noise and echo cancellation</string>
    <!-- Audio source option label: unprocessed / raw audio -->
    <string name="audio_source_unprocessed_label">Unprocessed</string>
    <!-- Audio source description: raw audio with no processing -->
    <string name="audio_source_unprocessed_description">Raw, no processing</string>

    <!-- QR code detection overlay -->
    <!-- QrResultOverlay: header title when QR code detected -->
    <string name="qr_result">QR Code</string>
    <!-- FidoQrCard: button to hand a FIDO registration QR to the passwords app. Verb. -->
    <string name="create_passkey">Create a passkey</string>
    <!-- FidoQrCard: button to hand a FIDO sign-in QR to the passwords app. Verb. -->
    <string name="sign_in_with_passkey">Sign in with a passkey</string>
    <!-- FidoQrCard: button when the FIDO QR carries no request-type hint. Verb. -->
    <string name="use_passkey">Use a passkey</string>
    <!-- QrResultOverlay: header title when an eSIM activation code QR is detected -->
    <!-- QrResultOverlay: button to hand an eSIM activation code to the system LPA. Verb. -->
    <string name="add_esim">Add eSIM</string>
    <!-- Toast error when no LPA can handle the eSIM activation intent -->
    <string name="no_app_to_add_esim">No app can add this eSIM</string>
    <!-- QrResultOverlay: button to open URL from QR. Verb. -->
    <string name="open_url">Open URL</string>
    <!-- Toast error when no app can handle the URL from QR -->
    <string name="no_app_to_open_url">No app can open this link</string>
    <!-- QrResultOverlay: button to copy QR text to clipboard. Verb. -->
    <string name="copy_text">Copy</string>
    <!-- CameraScreen overlay pill: the bound camera session has no analysis stream (some vendor
         night extensions cannot host one), so the viewfinder cannot look for QR codes -->
    <string name="qr_scanning_paused">QR scanning paused</string>

    <!-- Pro / manual controls -->
    <!-- CameraScreen: slider label for portrait blur/bokeh strength -->
    <string name="blur">Blur</string>
    <!-- Shown when ISO values not available. Abbreviation for Not Available -->
    <string name="not_available">N/A</string>
    <!-- ShutterRow overlay: counts burst shots taken while holding shutter. %1$d = shot count -->
    <string name="burst_count">Burst <xliff:g id="count" example="12">%1$d</xliff:g></string>

    <!-- Audio and focus controls -->
    <!-- CameraScreen overlay pill: auto-exposure and auto-focus locked after long press on preview -->
    <string name="ae_af_lock">AE/AF LOCK</string>

    <!-- Panorama and generic auto -->
    <!-- PanoramaOverlay: full-screen status while stitching panorama images. \u2026 is ellipsis -->
    <string name="processing_panorama_u2026">Processing panorama\u2026</string>

    <!-- Generic auto option for ISO / exposure / flash etc. Noun/adjective -->
    <string name="auto">Auto</string>
    <string name="night_2">Night %1$s%%</string>
    <string name="brightness">Brightness</string>
    <string name="shadows">Shadows</string>
    <string name="warmth">Warmth</string>

    <!-- LensBar: physical-lens picker above the zoom bar -->
    <!-- LensBar: label for the ultra-wide (0.5x) physical lens. Short pill label -->
    <string name="lens_ultrawide">UW</string>
    <!-- LensBar: label for the default wide (1x) physical lens. Short pill label -->
    <string name="lens_wide">1x</string>
    <!-- LensBar: label for the telephoto physical lens. Short pill label -->
    <string name="lens_tele">Tele</string>
    <!-- LensBar: label for the monochrome physical lens. Short pill label -->
    <string name="lens_mono">Mono</string>
    <!-- LensBar: label for the front-facing lens. Short pill label -->
    <string name="lens_front">Front</string>
    <!-- LensBar: content description for the physical-lens picker row -->
    <string name="lens_picker_description">Camera lens</string>

    <!-- Save location settings (SettingsPage) -->
    <!-- SettingsPage: section header for photo/video save location -->
    <string name="settings_save_location">Save location</string>
    <!-- SettingsPage: default save location summary, DCIM/Camera via MediaStore -->
    <string name="settings_save_location_default">DCIM/Camera</string>
    <!-- SettingsPage: button label opening the SAF folder picker -->
    <string name="settings_save_location_choose">Choose folder</string>
    <!-- SettingsPage: button label resetting the save location to the default -->
    <string name="settings_save_location_reset">Reset to default</string>
    <!-- SettingsPage: error notice when the chosen folder cannot be used -->
    <string name="settings_save_location_error">Couldn\'t use that folder</string>
</resources>
