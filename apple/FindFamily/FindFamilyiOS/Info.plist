<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.vayunmathur.findfamily.invite</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>findfamily</string>
			</array>
		</dict>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSContactsUsageDescription</key>
	<string>Used to pick a contact's name and photo to label the people you share location with.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Background location is used to share your location with people you've connected with in the app.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Location is used to share your location with people you've connected with in the app.</string>
	<key>NSUserNotificationsUsageDescription</key>
	<string>Notifications are used to alert you about sharing requests, low battery, and waypoint entries.</string>
	<key>NSNearbyInteractionUsageDescription</key>
	<string>Used for Precision Finding to show the exact distance and direction to a family member nearby.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Used by the Precision Finding feature to coordinate Ultra-Wideband ranging with a nearby family member's device.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
