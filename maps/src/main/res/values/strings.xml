    <plurals name="tts_kilometers">
        <item quantity="one"><xliff:g id="count" example="1">%1$d</xliff:g> kilometer</item>
        <item quantity="other"><xliff:g id="count" example="3">%1$d</xliff:g> kilometers</item>
    </plurals>

    <!-- BottomSheet: Current location label. Noun. -->
    <string name="your_location">Your location</string>
