    <string name="maneuver_roundabout">At the roundabout, continue onto <xliff:g id="road_name" example="Main St">%1$s</xliff:g></string>
    <!-- Maneuver: Roundabout unnamed -->
    <string name="maneuver_roundabout_unnamed">At the roundabout, continue</string>
