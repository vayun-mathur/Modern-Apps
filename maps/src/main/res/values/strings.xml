    <string name="transit_minutes_ago">%1$d min ago</string>
    <!-- Departure board: realtime delay vs schedule, signed. %1$d = signed minutes e.g. "+3 min" -->
    <!--
      Delay, in words. "+3 min" and "-4 min" made the reader work out which sign meant trouble;
      a train is late or early, and the board should just say so. Both take a positive number,
      so the sign lives in the wording rather than the digits.
    -->
    <string name="transit_late_minutes">%1$d min late</string>
    <string name="transit_early_minutes">%1$d min early</string>
