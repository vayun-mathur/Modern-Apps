<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- App name displayed in launcher -->
    <string name="app_name">Maps</string>

    <!-- TTS spoken: Announces next maneuver with distance. %1$s=distance string e.g. "1 kilometer", %2$s=maneuver instruction -->
    <string name="tts_in_distance">In <xliff:g id="distance" example="1 kilometer">%1$s</xliff:g>, <xliff:g id="instruction" example="Turn left onto Main St">%2$s</xliff:g></string>
    <!-- TTS spoken: Announces next maneuver within meters. %1$d=meters threshold e.g. 300, %2$s=instruction -->
    <string name="tts_in_meters">In <xliff:g id="meters" example="300">%1$d</xliff:g> meters, <xliff:g id="instruction" example="Turn right">%2$s</xliff:g></string>
