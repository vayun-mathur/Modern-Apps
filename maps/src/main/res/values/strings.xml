    <string name="search_category_gas">Gas</string>
    <!-- SearchPage: Quick category chip — grocery stores. Noun. -->
    <string name="search_category_groceries">Groceries</string>
    <!-- SearchPage: Quick category chip — hotels/lodging. Noun. -->
