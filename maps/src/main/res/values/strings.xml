    <string name="maneuver_ride_transit">Ride <xliff:g id="line_name" example="N-Judah">%1$s</xliff:g> from <xliff:g id="from_stop" example="Downtown">%2$s</xliff:g> to <xliff:g id="to_stop" example="Ocean Beach">%3$s</xliff:g> (<xliff:g id="stop_count" example="3">%4$d</xliff:g> stops)</string>

    <!-- Travel mode: Walking. Noun. -->
