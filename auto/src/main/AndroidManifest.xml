<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The projection session outlives any activity: it is bound to the cable or the wireless
         link, not to a screen the user is looking at. -->
    <!-- MAOS: opt out of the GrapheneOS Sensors permission (OTHER_SENSORS). -->
    <!-- This app uses no motion/environment sensors; MAOS withholds the -->
    <!-- Sensors permission at install instead of auto-granting it. -->
    <uses-permission android:name="com.vayunmathur.permission.SENSORS_OPTOUT" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- The head unit connects in over TCP. For the Desktop Head Unit that is an adb forward
         to loopback; for a real car it is the wireless link. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Bringing up the WiFi link to a wireless head unit. This is also what qualifies
         ProjectionService for the connectedDevice foreground type: that check accepts a USB
         accessory only when one is physically attached and permission-granted, so the USB
         filter below does not satisfy it on its own. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- WiFi Direct discovery toward the wireless head unit, plus the Bluetooth
         scan that finds it. Both are runtime-gated on the pairing screen
         (NEARBY_WIFI_DEVICES covers the WiFi half on S+). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- Android 12+ requires COARSE alongside FINE; the guidance monitor
         degrades to last-known without either (fail-closed), never crashes. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />
    <!-- Restart the projection listener after a reboot; the session is bound to
         the cable or the wireless link, not to an activity. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Retaining a car-mic voice turn for transcription. The ch6 channel
         itself needs no permission (chunks are acked and counted regardless);
         without this grant the phone keeps no voice data (fail-closed). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Music capture into the ch5 media sink: AudioPlaybackCapture of the USAGE_MEDIA
         mix needs the media-projection consent dialog, whose foreground service type
         is mediaProjection. The capture runs only while consented in-app AND granted
         here; either off means fail-closed silence on the head unit. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Background survival on API 34+ without a visible activity: the
         projection service declares the connectedDevice type (permission
         declared up top with the base FOREGROUND_SERVICE). The old
         microphone/location types are gone (see the service declaration):
         nothing captures device audio or reads device location directly,
         and claiming them crashed cold start on fresh installs. The runtime
         RECORD_AUDIO / location grants still gate their own features (ch6
         retention, ch7 phone seed) and are requested in-app. -->
    <!-- Wireless bring-up (BT_START -> RFCOMM -> TCP): discovery, association
         and the socket all need the Bluetooth family. The CDM trigger
         (CarCompanionDeviceService) additionally needs the association trio
         below; the pairing-screen stand-in path needs SCAN+CONNECT. -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_PRIVILEGED" />
    <uses-permission android:name="android.permission.LOCAL_MAC_ADDRESS" />
    <!-- Projected calls + message/call templates: the InCall pair
         (CarProjection/non-car) and reading the threads the mirror posts.
         Without these the call UI stays on the phone and restricted message
         data never reaches the car (fail-closed silence). -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.RECEIVE_SENSITIVE_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.GET_INTENT_SENDER_INTENT" />
    <!-- Wired auto-launch/role-switch/reset: the USB receivers and the reset
         chain. Privapp-gated (see the allowlist note below): without the
         allowlist entry this is inert and USB falls back to the plain
         attach/permission/open path, which needs no privileged grant. -->
    <uses-permission android:name="android.permission.MANAGE_USB" />
    <!-- Audio routing + telephony/in-call control + background launch: the
         sinks route to the car speakers (not the phone), the InCall pair
         controls the call, and background starts fire the startup chain.
         Privapp-gated like MANAGE_USB (see below). -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_ROUTING" />
    <uses-permission android:name="android.permission.TETHER_PRIVILEGED" />
    <uses-permission android:name="android.permission.POWER_SAVER" />
    <uses-permission android:name="android.permission.MANAGE_USERS" />
    <uses-permission android:name="android.permission.READ_PRIVILEGED_PHONE_STATE" />
    <uses-permission android:name="android.permission.CHANGE_COMPONENT_ENABLED_STATE" />
    <uses-permission android:name="android.permission.MODIFY_PHONE_STATE" />
    <uses-permission android:name="android.permission.CONTROL_INCALL_EXPERIENCE" />
    <uses-permission android:name="android.permission.CALL_PRIVILEGED" />
    <!-- Trusted display + projection control + secure capture: the virtual
         display route (TRUSTED vs PRIVATE), the projection toggle, and
         secure surfaces. Without these the display stays private-only and
         secure content renders black on the head unit. -->
    <uses-permission android:name="android.permission.ADD_TRUSTED_DISPLAY" />
    <uses-permission android:name="android.permission.ADD_ALWAYS_UNLOCKED_DISPLAY" />
    <uses-permission android:name="android.permission.CREATE_VIRTUAL_DEVICE" />
    <uses-permission android:name="android.permission.TOGGLE_AUTOMOTIVE_PROJECTION" />
    <uses-permission android:name="android.permission.CAPTURE_SECURE_VIDEO_OUTPUT" />
    <!-- Companion-device trigger for wireless: the CDM service
         (CarCompanionDeviceService) associates with the automotive-projection
         profile and fires the BT_START chain. Without these the association
         never forms and wireless stays on the pairing-screen stand-in. -->
    <uses-permission android:name="android.permission.ASSOCIATE_COMPANION_DEVICES" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_PROFILE_AUTOMOTIVE_PROJECTION" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_SELF_MANAGED" />
    <uses-permission android:name="android.permission.COMPANION_APPROVE_WIFI_CONNECTIONS" />
    <uses-permission android:name="android.permission.REQUEST_OBSERVE_COMPANION_DEVICE_PRESENCE" />
    <!-- Background/trusted launch: the startup chain (BT_START,
         START_USB_PROJECTION, deep links) and car-mode entry fire without a
         visible activity. Without these the chain can only start while the
         app is foreground. -->
    <uses-permission android:name="android.permission.START_ACTIVITIES_FROM_BACKGROUND" />
    <uses-permission android:name="android.permission.ENTER_CAR_MODE_PRIORITIZED" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.INTERACT_ACROSS_PROFILES" />
    <!-- Do-not-disturb state for the rail status cluster (DND icon): reading
         the interruption filter needs the policy grant; without it the icon
         stays gone (fail-closed), like every other absent source. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Privapp allowlist half (mirrors the MAOS role half in MaosRole):
         com.vayunmathur.auto must additionally allowlist MANAGE_USB,
         MODIFY_AUDIO_ROUTING, TETHER_PRIVILEGED, CALL_PRIVILEGED,
         POWER_SAVER, READ_PRIVILEGED_PHONE_STATE,
         CHANGE_COMPONENT_ENABLED_STATE, MANAGE_USERS,
         CAPTURE_SECURE_VIDEO_OUTPUT, BLUETOOTH_PRIVILEGED,
         CONTROL_INCALL_EXPERIENCE and MODIFY_PHONE_STATE. Both halves are
         boot-fatal if wrong: land one at a time. Gearhead's GMS-signed
         host permissions (NAVIGATION_TEMPLATES, ACCESS_SURFACE,
         GEARHEAD_SERVICE, START_PROJECTED_ACTIVITY) are not declarable by
         third parties and stay absent on purpose. -->

    <!-- The car launcher resolves Maps / Music / dialer through PackageManager. Android 11+
         hides other apps by default, so these queries keep those lookups visible. The media
         monitor also resolves the music browser service through getServiceInfo, which needs
         no query entry, but the explicit package row keeps the intent clear. -->
    <queries>
        <package android:name="com.vayunmathur.maps" />
        <package android:name="com.vayunmathur.music" />
        <package android:name="com.vayunmathur.communicate" />
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <!-- Third-party car apps: the launcher discovers CarAppService
             implementations per category (navigation, POI, IoT, weather) and
             hosts their templates generically. -->
        <intent>
            <action android:name="androidx.car.app.CarAppService" />
            <category android:name="androidx.car.app.category.NAVIGATION" />
        </intent>
        <intent>
            <action android:name="androidx.car.app.CarAppService" />
            <category android:name="androidx.car.app.category.POI" />
        </intent>
        <intent>
            <action android:name="androidx.car.app.CarAppService" />
            <category android:name="androidx.car.app.category.IOT" />
        </intent>
        <intent>
            <action android:name="androidx.car.app.CarAppService" />
            <category android:name="androidx.car.app.category.WEATHER" />
        </intent>
        <intent>
            <action android:name="androidx.car.app.CarAppService" />
            <category android:name="androidx.car.app.category.MESSAGING" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.General">

        <activity
            android:name=".MainActivity"
            android:configChanges="mcc|mnc|colorMode|density|fontScale|fontWeightAdjustment|keyboard|keyboardHidden|layoutDirection|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.General">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Plugging into a head unit puts the phone into AOAP accessory mode and
                 Android hands the connection to whoever matches, which is also how the app
                 gets launched on plug-in. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED"
                android:resource="@xml/usb_accessory_filter" />
        </activity>

        <!-- No `microphone`/`location` types: the service never captures
             device audio or reads device location directly. The ch6 mic path
             reads GAL chunks off the socket (acked/counted permission-free;
             RECORD_AUDIO gates only in-memory retention), and the ch7 phone
             seed flows through `NavGuidanceMonitor` (all `runCatching`-
             guarded, degrades to last-known). Claiming either type crashes
             cold start on a fresh install (no grant yet) with
             SecurityException: that was the recurring crash. -->
        <service
            android:name=".service.ProjectionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
        <!-- Holds the media-projection token while music capture runs. Started
             only after the user grants the consent dialog (see MusicCaptureGrant):
             on API 34+ an FGS with type mediaProjection cannot start before the
             projection is registered, so this lives apart from ProjectionService
             rather than widening its foreground type and crashing bring-up. -->
        <service
            android:name=".service.MusicCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Answers the USB permission round-trip and accessory detach while no
             activity is up; both funnel into UsbConnector. The permission action
             is app-private (setPackage on request). The force-start chain action
             (CarStartupService START_USB_PROJECTION) funnels there too. -->
        <receiver
            android:name=".platform.UsbReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.vayunmathur.auto.USB_PERMISSION" />
                <action android:name="android.hardware.usb.action.USB_ACCESSORY_DETACHED" />
                <action android:name="com.vayunmathur.auto.USB_ACCESSORY_FORCE_START" />
            </intent-filter>
        </receiver>

        <!-- TPlus head-unit announce/detach: funnels into the same USB attach
             path (see UsbTPlusReceiver); the framing difference is HU-side. -->
        <receiver
            android:name=".platform.UsbTPlusReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.vayunmathur.auto.USB_TPLUS_ATTACHED" />
                <action android:name="com.vayunmathur.auto.USB_TPLUS_DETACHED" />
            </intent-filter>
        </receiver>

        <!-- USB role/port/gadget/function resets: re-arms the projection
             listener after the stack re-enumerates (see
             ConnectionResetReceiver). MA-defined equivalents of gearhead's
             internal reset chain. -->
        <receiver
            android:name=".platform.ConnectionResetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.vayunmathur.auto.RESET_USB_PORT" />
                <action android:name="com.vayunmathur.auto.RESET_GADGET" />
                <action android:name="com.vayunmathur.auto.RESET_ROLES" />
                <action android:name="com.vayunmathur.auto.RESET_FUNCTION" />
            </intent-filter>
        </receiver>

        <!-- Link changes under a wireless session (see
             ConnectivityEventReceiver). -->
        <receiver
            android:name=".platform.ConnectivityEventReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.net.conn.CONNECTIVITY_CHANGE" />
            </intent-filter>
        </receiver>

        <!-- Re-starts the projection listener after a reboot or an app
             update. Runs in :car like gearhead's init receiver; both the boot
             and the replaced actions restart plus republish the role. -->
        <receiver
            android:name=".platform.BootReceiver"
            android:exported="true"
            android:process=":car">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Mirrors phone message notifications onto the projection session's
             ch14 owner via MessageMirrorBus. The system binds this itself once
             the user enables MA Auto in notification-access settings; posting
             additionally requires the in-app consent switch (MessagingPrefs),
             so either gate off means fail-closed silence. Single-user (one
             listener across profiles would double-mirror), sensitive
             notifications permitted (templates would otherwise arrive empty),
             and the mirror filter declares the CATEGORY_MESSAGE gate. -->
        <service
            android:name=".notifications.MessageMirrorService"
            android:exported="true"
            android:label="@string/messaging_headline"
            android:singleUser="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <meta-data
                android:name="com.vayunmathur.auto.MIRROR_FILTER"
                android:resource="@xml/message_mirror_filter" />
        </service>

        <!-- Projected calls (car-mode InCall half of the NonCar/CarProjection
             split). The platform binds this in car mode with the InCall grant;
             needs CALL_PHONE/READ_PHONE_STATE/CONTROL_INCALL_EXPERIENCE. -->
        <service
            android:name=".telephony.CarProjectionInCallService"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
        </service>

        <!-- Non-car InCall half: manifest-disabled, never bound (see
             NonCarInCallService). Declared so the package surfaces match
             gearhead's split. -->
        <service
            android:name=".telephony.NonCarInCallService"
            android:exported="false"
            android:enabled="false"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>

        <!-- Companion-device trigger for wireless projection (CDM,
             automotive-projection profile). Fires the BT_START chain on
             association; runs in :car like gearhead's. The system binds this
             under the CDM association grant (ASSOCIATE_COMPANION_DEVICES
             above); no separate bind permission exists for the
             automotive-projection profile. -->
        <service
            android:name=".platform.CarCompanionDeviceService"
            android:exported="true"
            android:process=":car"
            android:permission="android.permission.ASSOCIATE_COMPANION_DEVICES">
            <intent-filter>
                <action android:name="android.companion.CompanionDeviceService" />
            </intent-filter>
        </service>

        <!-- Head-unit compositor/decor bind targets (exported, like
             gearhead's): binds are safely rejected: MA renders CarDisplay
             into ch2 video rather than hosting HU-composited windows. -->
        <service
            android:name=".platform.CarSystemUiControllerService"
            android:exported="true" />
        <service
            android:name=".platform.AppDecorService"
            android:exported="true" />

        <!-- Chimera entry point (GMS-compat car.service.START): funnels into
             the projection service. Same single type as ProjectionService
             (no mic/location types: nothing here captures device audio or
             reads device location either). -->
        <service
            android:name=".platform.CarChimeraService"
            android:exported="true"
            android:foregroundServiceType="connectedDevice">
            <intent-filter>
                <action android:name="car.service.START" />
            </intent-filter>
        </service>

        <!-- First-time setup handshake target: binds safely rejected (the
             pairing screen owns setup). -->
        <service
            android:name=".platform.CarSetupService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.vayunmathur.auto.CAR_SETUP_SERVICE" />
            </intent-filter>
        </service>

        <!-- Head-unit startup chain (BT_START + START_USB_PROJECTION +
             CAR_STARTUP_NOTIFICATION): starts the phone side without the app
             open. -->
        <service
            android:name=".platform.CarStartupService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.vayunmathur.auto.BT_START" />
                <action android:name="com.vayunmathur.auto.START_USB_PROJECTION" />
                <action android:name="com.vayunmathur.auto.CAR_STARTUP_NOTIFICATION" />
            </intent-filter>
        </service>

        <!-- Wireless setup pair: the shared service owns the phone half (tap
             stand-in or CDM MAC), the car service's bind is safely rejected
             (credentials ride CDM/RFCOMM, not a binder). -->
        <service
            android:name=".platform.WirelessSetupSharedService"
            android:exported="false" />
        <service
            android:name=".platform.WirelessSetupCarService"
            android:exported="true" />

        <!-- BT/WiFi state during wireless setup (ACL + adapter state). -->
        <receiver
            android:name=".platform.WifiBluetoothReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
                <action android:name="android.bluetooth.adapter.action.STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Wireless head-unit announcement: enters the BT_START chain. -->
        <receiver
            android:name=".platform.WirelessStartupReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.vayunmathur.auto.WIRELESS_STARTUP" />
            </intent-filter>
        </receiver>

        <!-- Wireless first-run entry + deep-link router: no UI, they enter
             the startup chain and finish. -->
        <activity
            android:name=".platform.WirelessStartupActivity"
            android:exported="true"
            android:theme="@style/Theme.General"
            android:noHistory="true"
            android:excludeFromRecents="true" />
        <activity
            android:name=".platform.DeepLinkResolverActivity"
            android:exported="true"
            android:theme="@style/Theme.General"
            android:noHistory="true"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="maauto" />
            </intent-filter>
        </activity>
    </application>
</manifest>
