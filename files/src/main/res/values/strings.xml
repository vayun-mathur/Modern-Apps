<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- App name displayed in launcher and system settings -->
    <string name="app_name">Files</string>
    <!-- HomeDirectoryPage: Dialog title asking user to grant notification permission -->
    <string name="enable_notifications">Enable Notifications?</string>
    <!-- HomeDirectoryPage: Dialog body explaining why notifications are needed. Noun, rationale -->
    <string name="notification_permission_rationale">Turning on notifications will allow you to see progress on background actions like zipping and unzipping files.</string>
    <!-- Generic verb. Button to enable notifications / grant permission -->
    <string name="enable">Enable</string>
    <!-- Generic verb. Button to skip notification opt-in -->
    <string name="skip">Skip</string>
    <!-- HomeDirectoryPage: Button to open system settings to grant MANAGE_ALL_FILES permission -->
    <string name="grant_all_files_access">Grant All Files Access</string>
    <!-- Archive dialog title. Noun phrase, appears when user selects files to zip -->
    <string name="archive_selection">Archive Selection</string>
    <!-- Archive dialog: TextField label for output zip file name -->
    <string name="zip_file_name_label">Zip file name</string>
    <!-- Snackbar: archiving background work has started. Verb phrase -->
    <string name="archiving_started">Archiving started…</string>
    <!-- Generic verb. Confirm button in archive dialog to start zipping -->
    <string name="archive">Archive</string>
    <!-- Snackbar after unzip enqueued. %1$s = destination folder name -->
    <string name="unzipping_started_to">Unzipping started to <xliff:g id="dest_name" example="Downloads">%1$s</xliff:g></string>
    <!-- Snackbar error when move/rename fails. %1$s = error message from exception -->
    <string name="move_failed">Move failed: <xliff:g id="error" example="Permission denied">%1$s</xliff:g></string>
    <!-- Snackbar error when zip file cannot be opened. %1$s = error details -->
    <string name="could_not_open_zip">Could not open zip: <xliff:g id="error" example="Invalid format">%1$s</xliff:g></string>
    <!-- Snackbar when an archive would not fit. %1$s = expanded size, %2$s = space available for it -->
    <string name="zip_too_large_to_extract">Too large to extract: needs <xliff:g id="needed" example="4.2 GB">%1$s</xliff:g>, only <xliff:g id="available" example="1.1 GB">%2$s</xliff:g> usable</string>
    <!-- Snackbar when no app can handle ACTION_VIEW intent for a file -->
    <string name="no_app_found_to_open_file">No app found to open this file</string>
    <!-- Snackbar/info when user tries to open file while browsing inside zip (read-only mode) -->
    <string name="zip_browse_only">Viewing files inside zip is limited to browsing</string>
    <!-- Snackbar shown when an APK is tapped but Files hasn't been granted permission to install apps -->
    <string name="install_permission_needed">Allow Files to install unknown apps, then tap the APK again</string>
    <!-- Snackbar shown when the user returns from settings without granting install permission -->
    <string name="install_permission_denied">Permission to install apps was not granted</string>
    <!-- Notification channel name for unzip foreground service -->
    <string name="unzip_channel_name">Unzip Operations</string>
    <!-- Foreground notification title while unzipping in progress -->
    <string name="unzipping">Unzipping…</string>
    <!-- Notification channel name for zip foreground service -->
    <string name="zip_channel_name">Zip Operations</string>
    <!-- Foreground notification title while archiving/zip in progress -->
    <string name="archiving">Archiving…</string>
    <!-- Snackbar: incoming shared files saved to current directory successfully -->
    <string name="files_saved">Files saved successfully</string>

    <!-- Placeholder shown in the search field -->
    <string name="search_files">Search files…</string>
    <!-- Sort option: by file size -->
    <string name="sort_size">Size</string>
    <!-- Sort option: by file type/extension -->
    <string name="sort_type">Type</string>
    <!-- Sort direction options -->
    <string name="sort_ascending">Ascending</string>
    <string name="sort_descending">Descending</string>
    <!-- Menu item switching between grid and list layouts -->
    <string name="grid_view">Grid view</string>
    <string name="list_view">List view</string>
    <!-- Menu item selecting every item in the current folder -->
    <string name="select_all">Select all</string>
    <!-- Selection action: cut (move) selected files to the clipboard -->
    <string name="cut">Cut</string>
    <!-- Action: paste clipboard files into the current folder -->
    <string name="paste">Paste</string>
    <!-- Rename dialog: TextField label for the new name -->
    <string name="new_name_label">New name</string>
    <!-- Snackbar after copying to clipboard. %1$d = item count -->
    <string name="copied_n">Copied <xliff:g id="count" example="3">%1$d</xliff:g> item(s)</string>
    <!-- Snackbar after cutting to clipboard. %1$d = item count -->
    <string name="cut_n">Cut <xliff:g id="count" example="3">%1$d</xliff:g> item(s)</string>
    <!-- Paste bar label. %1$d = number of items on the clipboard -->
    <string name="ready_to_paste"><xliff:g id="count" example="3">%1$d</xliff:g> item(s) ready to paste</string>

    <!-- Snackbar when creating a file/folder fails -->
    <string name="create_failed">Could not create item</string>
    <!-- Snackbar after bookmarking a folder -->
    <string name="bookmark_added">Bookmark added</string>

    <!-- Home screen: category shortcut labels -->
    <string name="cat_images">Images</string>
    <string name="cat_videos">Videos</string>
    <string name="cat_audio">Audio</string>
    <string name="cat_documents">Documents</string>
    <string name="cat_downloads">Downloads</string>

    <!-- Home screen section headers -->
    <string name="internal_storage">Internal storage</string>
    <string name="categories">Categories</string>
    <string name="bookmarks">Bookmarks</string>
    <string name="recent_files">Recent files</string>
    <!-- Storage meter caption. %1$s = used size, %2$s = total size -->
    <string name="storage_usage"><xliff:g id="used" example="12 GB">%1$s</xliff:g> used of <xliff:g id="total" example="128 GB">%2$s</xliff:g></string>

    <!-- Create menu items and dialogs -->
    <string name="new_folder">New folder</string>
    <string name="new_file">New file</string>
    <string name="folder_name_label">Folder name</string>
    <string name="file_name_label">File name</string>

    <!-- Selection actions -->
    <string name="open_with">Open with</string>
    <string name="properties">Properties</string>
    <string name="add_bookmark">Add bookmark</string>

    <!-- Overflow: show/hide dot-prefixed hidden files -->
    <string name="show_hidden">Show hidden files</string>
    <string name="hide_hidden">Hide hidden files</string>

    <!-- Empty folder placeholder -->
    <string name="no_files">Nothing here</string>

    <!-- Properties dialog rows -->
    <string name="prop_path">Path</string>
    <string name="prop_modified">Modified</string>
    <string name="prop_items">Contents</string>
    <string name="type_folder">Folder</string>
    <string name="type_file">File</string>
    <!-- Folder contents count. %1$d = number of items -->
    <string name="items_count"><xliff:g id="count" example="12">%1$d</xliff:g> item(s)</string>

    <!-- SAF document picker (shown only when Files is the system documents UI) -->
    <!-- Title when the caller is opening/selecting existing files -->
    <string name="saf_title_open">Select a file</string>
    <!-- Title when the caller is creating/saving a new file -->
    <string name="saf_title_create">Save file</string>
    <!-- Title when the caller is picking a folder (grants access to the whole tree) -->
    <string name="saf_title_tree">Select a folder</string>
    <!-- Button confirming the current folder as the picked tree -->
    <string name="saf_use_this_folder">Use this folder</string>
    <!-- Button confirming a multi-file selection. %1$d = number selected -->
    <string name="saf_select_count">Select (<xliff:g id="count" example="3">%1$d</xliff:g>)</string>

    <!-- Navigation drawer + Home entry for the system trash -->
    <string name="trash">Trash</string>
    <!-- Trash screen: empty-state placeholder -->
    <string name="trash_empty">Trash is empty</string>
    <!-- Trash screen: caption explaining the system trash auto-deletes. Noun phrase -->
    <string name="trash_auto_delete_note">Items are permanently deleted after 30 days</string>
    <!-- Selection action: restore trashed items to their original location -->
    <string name="restore">Restore</string>
    <!-- Selection action: permanently delete trashed items -->
    <string name="delete_forever">Delete forever</string>
    <!-- Trash screen action: permanently delete everything in the trash -->
    <string name="empty_trash">Empty trash</string>
    <!-- Permanent-delete confirmation dialog title. %1$d = item count -->
    <string name="delete_permanently_title">Delete <xliff:g id="count" example="3">%1$d</xliff:g> item(s) permanently?</string>
    <!-- Permanent-delete confirmation dialog body: folders cannot use the system trash -->
    <string name="delete_permanently_message">This cannot be undone. Folders and some files cannot be moved to the trash.</string>
    <!-- Snackbar after moving items to the system trash. %1$d = item count -->
    <string name="moved_to_trash"><xliff:g id="count" example="3">%1$d</xliff:g> item(s) moved to trash</string>
    <!-- Snackbar after restoring trashed items. %1$d = item count -->
    <string name="restored_n">Restored <xliff:g id="count" example="3">%1$d</xliff:g> item(s)</string>
    <!-- Snackbar after permanently deleting trashed items. %1$d = item count -->
    <string name="deleted_forever_n">Deleted <xliff:g id="count" example="3">%1$d</xliff:g> item(s) permanently</string>
    <!-- Snackbar when the system trash-consent dialog cannot be shown -->
    <string name="trash_request_failed">Could not open the trash request</string>

    <!-- Text editor: shown instead of an editor when the file could not be read -->
    <string name="editor_load_failed">Could not read this file, so it cannot be edited here. The original file was not changed.</string>
    <!-- Text editor: shown when writing the edited content back failed -->
    <string name="editor_save_failed">Could not save your changes. The file on disk was not updated.</string>
</resources>
