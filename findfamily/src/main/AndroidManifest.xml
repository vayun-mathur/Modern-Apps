<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-permission android:name="android.permission.READ_CONTACTS" android:maxSdkVersion="36"/>

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      The 15-minute active location check (#895 follow-up) has to run in Doze, where the
      heartbeat coroutine does not: an exact allow-while-idle alarm wakes the CPU and a short
      partial wake lock covers the fix. USE_EXACT_ALARM is install-granted (non-revocable) on
      API 33+; SCHEDULE_EXACT_ALARM covers 31-32, where it is granted by default.
      FixCeilingAlarm still checks canScheduleExactAlarms() and falls back to an inexact
      allow-while-idle alarm armed early enough to stay inside 15 minutes. Distributed via
      F-Droid and its own store, so Play's alarm-app-only USE_EXACT_ALARM policy does not
      apply (same declaration as calendar and todo).
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />

    <!--
      Powered-off finding, finder half. Arming a beacon needs BLUETOOTH_PRIVILEGED, which is
      signature|privileged and so only ever available to a preinstalled build — but *hearing* one
      is ordinary BLE, and the network is only worth anything if plenty of phones are listening.
      So this is declared here rather than in src/dev: an F-Droid install has to be able to
      contribute sightings too. Scanning still does nothing until the user opts in
      (CROWD_FINDING_ENABLED_KEY, default off).
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <uses-permission android:name="android.permission.RANGING" />
    <!-- Powered-off finding (NearbyManager#setPoweredOffFindingEphemeralIds). signature|privileged,
         so this is only actually granted when findfamily is installed as a MAOS priv-app with a
         matching privapp-permissions entry; everywhere else the calls throw SecurityException and
         PoweredOffBeacon treats the feature as absent. Requesting it here is harmless either way. -->
    <uses-permission android:name="android.permission.BLUETOOTH_PRIVILEGED" />
    <uses-feature android:name="android.hardware.uwb" android:required="false" />

    <permission
        android:name="com.vayunmathur.findfamily.permissions.ACCESS_FAMILY"
        android:protectionLevel="signature" />

    <application
        android:allowBackup="true"
        android:backupAgent=".util.AppBackupAgent"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.General">
        <activity
            android:configChanges="mcc|mnc|colorMode|density|fontScale|fontWeightAdjustment|keyboard|keyboardHidden|layoutDirection|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.General">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="findfamily" android:host="add" />
            </intent-filter>
            <!-- Long-pressing a Quick Settings tile resolves this action; without it the
                 system falls back to the App Info page (GitHub #545). -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".util.LocationTrackingService"
            android:foregroundServiceType="location"
            android:directBootAware="true"
            android:exported="false" />

        <service
            android:name=".ipc.FamilyLocationService"
            android:exported="true"
            android:permission="com.vayunmathur.findfamily.permissions.ACCESS_FAMILY">
            <intent-filter>
                <action android:name="com.vayunmathur.findfamily.action.FAMILY_LOCATIONS" />
            </intent-filter>
        </service>

        <service
            android:name=".util.TrackingTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_tracking"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVITY"
                android:value=".MainActivity" />
        </service>

        <service
            android:name=".service.SharingTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_sharing"
            android:label="@string/sharing_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVITY"
                android:value=".MainActivity" />
        </service>


        <receiver
            android:name=".platform.FixCeilingReceiver"
            android:directBootAware="true"
            android:exported="false" />

        <receiver
            android:name=".util.BootReceiver"
            android:directBootAware="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".intents.GetIntent"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay"
            android:permission="com.vayunmathur.findfamily.permissions.ACCESS_FAMILY">
        </activity>

        <activity
            android:name=".intents.CreateLinkIntent"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay"
            android:permission="com.vayunmathur.findfamily.permissions.ACCESS_FAMILY">
        </activity>
    </application>

</manifest>