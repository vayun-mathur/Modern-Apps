<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- MAOS: opt out of the GrapheneOS Sensors permission (OTHER_SENSORS). -->
    <!-- This app uses no motion/environment sensors; MAOS withholds the -->
    <!-- Sensors permission at install instead of auto-granting it. -->
    <uses-permission android:name="com.vayunmathur.permission.SENSORS_OPTOUT" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Live Updates (API 36 ProgressStyle promoted ongoing): install-time, no runtime prompt. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      signature|privileged, so all four require an entry in
      vendor/modern-apps/privapp-permissions-modern-apps.xml whose package= byte-matches
      com.vayunmathur.updater. A mismatch there is boot-fatal under
      ro.control_privapp_permissions=enforce, not a silent no-op.
    -->
    <!-- Reboot into the freshly written slot once the payload is applied. -->
    <uses-permission android:name="android.permission.REBOOT" />
    <!-- update_engine stages payload metadata under /cache. -->
    <uses-permission android:name="android.permission.ACCESS_CACHE_FILESYSTEM" />
    <!-- Lets update_engine reclaim space aggressively when the inactive slot is tight. -->
    <uses-permission android:name="android.permission.ALLOCATE_AGGRESSIVE" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.General">

        <!--
          **Not a launcher activity.** An OTA client is something the user goes looking for in
          Settings, under System > System update, rather than an app they open - so it answers
          `android.settings.SYSTEM_UPDATE_SETTINGS` and shows no icon.

          That action is exactly what `SystemUpdateRepository.getSystemUpdateIntent` resolves, with
          `MATCH_SYSTEM_ONLY`; the preference is *removed* from the System screen when nothing
          answers it, which is why the row was missing rather than merely inert. Being preinstalled
          under /product satisfies the system-only match.

          `exported` stays true because the caller is Settings, in another process.
        -->
        <activity
            android:configChanges="mcc|mnc|colorMode|density|fontScale|fontWeightAdjustment|keyboard|keyboardHidden|layoutDirection|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.General">
            <intent-filter>
                <action android:name="android.settings.SYSTEM_UPDATE_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          specialUse, not dataSync: Android 15 caps dataSync at six cumulative hours a day and
          Android 13/14 refuse to let a boot receiver start one. Neither suits a 1-2 GB transfer
          followed by an A/B slot write that must not be abandoned halfway.
        -->
        <service
            android:name=".service.UpdateInstallService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Downloads, signature-verifies and applies a full system OTA to the inactive A/B slot. The transfer is 1-2 GB and the slot write cannot be interrupted partway without leaving the update unusable." />
        </service>

        <!--
          BIND_JOB_SERVICE is required by the platform for any JobService. Idle detection is
          the scheduler's (setRequiresDeviceIdle), not ours.
        -->
        <service
            android:name=".platform.IdleReboot"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Re-schedules the periodic check; see the class doc for why it does not install. -->
        <receiver
            android:name=".platform.UpdateBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
          Not exported: the only intent it accepts comes from this app's own PendingIntent on
          the update-ready notification, and what it does is reboot the device.
        -->
        <receiver
            android:name=".platform.RebootReceiver"
            android:exported="false" />
    </application>

</manifest>
