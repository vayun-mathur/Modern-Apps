<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- MAOS: opt out of the GrapheneOS Sensors permission (OTHER_SENSORS). -->
    <!-- This app uses no motion/environment sensors; MAOS withholds the -->
    <!-- Sensors permission at install instead of auto-granting it. -->
    <uses-permission android:name="com.vayunmathur.permission.SENSORS_OPTOUT" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Local Network Protections (Android 16+): without this NsdManager.discoverServices throws
         SecurityException and every LAN socket is blocked, so the device list is silently empty. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- AudioRecord needs this even for playback capture, where no microphone is involved: the
         permission gates the API, not the source. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Both halves of RemoteDisplayProviderWatcher.verifyServiceTrusted: the app must hold
         REMOTE_DISPLAY_PROVIDER and the service must be guarded by BIND_REMOTE_DISPLAY. Failing
         either one is not an error the user sees - the watcher logs and skips the service, and the
         Cast page is simply empty. Signature|privileged, so it needs the priv-app allowlist entry
         in vendor/modern-apps/privapp-permissions-modern-apps.xml. -->
    <uses-permission android:name="android.permission.REMOTE_DISPLAY_PROVIDER" />
    <!-- Desktop-mode audio. That path holds no MediaProjection - which is what lets it run with
         no consent dialog - so AudioPlaybackCapture is unavailable and audio comes from
         MediaRecorder.AudioSource.REMOTE_SUBMIX instead, the platform's own remote-display audio
         source. REMOTE_SUBMIX is gated on this permission. Signature|privileged, so it needs the
         priv-app allowlist entry in vendor/modern-apps/privapp-permissions-modern-apps.xml.
         Screen mirroring does NOT use this: it keeps the projection-scoped capture, which is
         narrower and honours each app's own allowCapture policy. -->
    <uses-permission android:name="android.permission.CAPTURE_AUDIO_OUTPUT" />
    <!-- Selecting a route in Settings has to end at CastPairActivity, which takes six digits off
         the TV. By then Settings is in front and this app is a bound service in the background, so
         without this the launch is silently dropped and the route sits at CONNECTING for ever.
         protectionLevel is signature|privileged|vendorPrivileged|oem|verifier|role, so the priv-app
         allowlist entry is what grants it. -->
    <uses-permission android:name="android.permission.START_ACTIVITIES_FROM_BACKGROUND" />
    <!-- Lets MaRemoteDisplayProvider create the cast display with VIRTUAL_DISPLAY_FLAG_TRUSTED.
         MediaRouterService never creates a display for a remote display route - it only reads back
         the id the provider publishes via RemoteDisplay.setPresentationDisplayId - so the display
         is ours to make. TRUSTED is what lets the system extend onto it and is required by
         VIRTUAL_DISPLAY_FLAG_ALLOWS_CONTENT_MODE_SWITCH, which is what hands the mirror-vs-extend
         choice to Settings instead of building one here.

         protectionLevel is signature|role. It is NOT signature|privileged, so it does not belong in
         privapp-permissions-modern-apps.xml - an entry there is boot-fatal. Nor is it granted by
         platform signing: ModernAppsCast in vendor/modern-apps/Android.bp is presigned, not
         certificate: "platform". It is carried by the SYSTEM_AUTOMOTIVE_PROJECTION role, pinned to
         this package by config_systemAutomotiveProjection in MaosFrameworkResRRO, which is why
         dumpsys reports it as GRANTED_BY_ROLE. Note the role auto-grants its whole permission
         list, RECORD_AUDIO among them.

         Deliberately not CAPTURE_VIDEO_OUTPUT: that gate only guards
         VIRTUAL_DISPLAY_FLAG_AUTO_MIRROR, and ALLOWS_CONTENT_MODE_SWITCH suppresses AUTO_MIRROR
         being added to a PUBLIC display, so the check is never reached. -->
    <uses-permission android:name="android.permission.ADD_TRUSTED_DISPLAY" />

    <uses-feature android:name="android.hardware.wifi" android:required="false" />

    <permission
        android:name="com.vayunmathur.cast.permission.STREAM_CONTENT"
        android:label="@string/cast_stream_content_permission_label"
        android:description="@string/cast_stream_content_permission_desc"
        android:protectionLevel="signature" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.General">
        <!-- The remote display provider API is a shared library, not part of the base framework.
             Optional so the app still installs on a stock device, where nothing binds
             CastRemoteDisplayService anyway. -->
        <uses-library
            android:name="com.android.media.remotedisplay"
            android:required="false" />

        <activity
            android:name=".MainActivity"
            android:configChanges="mcc|mnc|colorMode|density|fontScale|fontWeightAdjustment|keyboard|keyboardHidden|layoutDirection|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.General">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>
        <!-- Launcher entry as an alias so MAOS can hide it (there the app's own screen-sharing UI
             is redundant - the OS drives casting) without disabling MainActivity, which is still
             reached as the QS tile's preferences/settings activity. CastApplication disables this
             alias when the app is the privileged system remote-display provider (only on MAOS); on
             an ordinary install it stays enabled and the icon shows. -->
        <activity-alias
            android:name=".LauncherAlias"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".platform.mirror.MirrorConsentActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- The pair prompt for a route selected in Settings. Launched by
             MaRemoteDisplayProvider over whatever is in front, on the same
             START_ACTIVITIES_FROM_BACKGROUND grant MirrorConsentActivity needs. Not exported: the
             only caller is this app's own provider, and the SDK path pairs inside
             CastPickerActivity instead. configChanges so a rotation does not throw away digits the
             user has already typed. -->
        <activity
            android:name=".platform.CastPairActivity"
            android:configChanges="mcc|mnc|colorMode|density|fontScale|fontWeightAdjustment|keyboard|keyboardHidden|layoutDirection|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.CastPair" />

        <activity
            android:name=".platform.CastPickerActivity"
            android:configChanges="mcc|mnc|colorMode|density|fontScale|fontWeightAdjustment|keyboard|keyboardHidden|layoutDirection|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:permission="com.vayunmathur.cast.permission.STREAM_CONTENT"
            android:theme="@style/Theme.General" />

        <service
            android:name=".service.CastService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|mediaPlayback" />

        <!-- Bound by system_server's RemoteDisplayProviderWatcher, which is what puts this app's
             receivers in Settings' Cast page. BIND_REMOTE_DISPLAY is required by the watcher, not
             merely prudent - see MaRemoteDisplayProvider. -->
        <service
            android:name=".service.CastRemoteDisplayService"
            android:exported="true"
            android:permission="android.permission.BIND_REMOTE_DISPLAY">
            <intent-filter>
                <action android:name="com.android.media.remotedisplay.RemoteDisplayProvider" />
            </intent-filter>
        </service>

        <service
            android:name=".service.ContentCastService"
            android:exported="true"
            android:permission="com.vayunmathur.cast.permission.STREAM_CONTENT" />

        <service
            android:name=".platform.mirror.MirrorTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_cast_mirror"
            android:label="@string/cast_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVITY"
                android:value="com.vayunmathur.cast.MainActivity" />
        </service>
    </application>
</manifest>
