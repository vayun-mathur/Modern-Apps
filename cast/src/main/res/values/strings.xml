<resources>
    <string name="app_name">Cast</string>

    <!-- Device list -->
    <string name="cast_devices_heading">Televisions</string>
    <string name="cast_searching">Searching for televisions.</string>
    <string name="cast_no_devices">No televisions found</string>
    <string name="cast_no_devices_hint">Install MA Cast on your Android TV or Google TV and open it once. It only needs to be on the same Wi\u2011Fi network \u2014 neither device needs internet access.</string>
    <string name="cast_device_subtitle">%1$s</string>
    <string name="cast_local_network_blocked">Local network access is off</string>
    <string name="cast_local_network_blocked_hint">Android blocks discovering devices on your network until this app is allowed to. Grant local network access in system settings and try again.</string>
    <string name="cast_open_settings">Open settings</string>
    <string name="cast_disconnect">Disconnect</string>
    <string name="cast_connecting_to">Connecting to %1$s.</string>
    <string name="cast_connected_to">Connected to %1$s</string>
    <string name="cast_connect_failed">Could not reach %1$s</string>
    <string name="cast_retry">Try again</string>

    <!-- Pairing. The six digits are shown on the TV and typed here; they are bound to the
         handshake transcript, which is what makes six digits enough. -->
    <string name="cast_pairing_with">Pairing with %1$s</string>
    <string name="cast_pair_title">Pair with %1$s</string>
    <string name="cast_pair_hint">Your TV is showing a six\u2011digit code. Type it here to pair. You will only be asked once per TV.</string>
    <string name="cast_pair_code_label">Code from your TV</string>
    <string name="cast_pair_submit">Pair</string>
    <plurals name="cast_pair_attempts">
        <item quantity="one">Wrong code. %1$d attempt left.</item>
        <item quantity="other">Wrong code. %1$d attempts left.</item>
    </plurals>
    <string name="cast_pair_new_code">Wrong code three times, so your TV is now showing a new one. Look again.</string>
    <string name="cast_pair_rejected">Pairing was refused</string>

    <!-- Session failures -->
    <string name="cast_connect_lost">The connection to the TV was lost</string>
    <string name="cast_version_mismatch">This TV is running a different version of MA Cast. Update both apps.</string>
    <string name="cast_protocol_error">The TV did not answer the way it should</string>

    <!-- Mirroring -->
    <string name="cast_start_mirroring">Mirror my screen</string>
    <string name="cast_stop_mirroring">Stop mirroring</string>
    <string name="cast_status_ready">Ready to mirror</string>
    <string name="cast_status_starting">Starting.</string>
    <string name="cast_status_mirroring">Mirroring your screen</string>
    <string name="cast_status_failed">Mirroring stopped</string>
    <string name="cast_mirror_audio_degraded">Audio is unavailable, so only the picture is being sent. Apps that block audio capture, and devices without an Opus encoder, both cause this.</string>
    <string name="cast_mirror_video_degraded">Video is unavailable on this device, so only audio is being sent.</string>
    <string name="cast_mirror_unavailable">This device cannot capture the screen</string>
    <string name="cast_mirror_negotiation_failed">The TV refused to start a stream</string>
    <string name="cast_mirror_udp_failed">Could not reach the TV to send video</string>
    <string name="cast_mirror_no_encoder">This device has no usable screen encoder</string>
    <string name="cast_mirror_tv_no_audio">This TV cannot play Opus audio, so it cannot play music from this phone</string>
    <string name="cast_mirror_receiver_gone">The TV stopped accepting the stream</string>
    <!-- Naming the codecs is the point of these three. Mirroring needs hardware H.265 or AV1 and has
         no H.264 fallback, so a device that cannot do either will never work - and a message that did
         not say which codec was missing would leave no way to find that out. -->
    <string name="cast_mirror_phone_no_codec">This phone has no hardware video encoder. Mirroring needs %1$s.</string>
    <string name="cast_mirror_tv_no_codec">This TV has no hardware video decoder. Mirroring needs %1$s.</string>
    <string name="cast_mirror_no_common_codec">This phone can send %1$s and this TV can decode %2$s, but nothing they share works at this screen size.</string>
    <string name="cast_mirror_codec_demoted">%1$s did not work with this TV before, and there is no other codec you both support. Pair with this TV again to retry it.</string>
    <string name="cast_mirror_codec_config_failed">The TV could not be given the video settings it needed. The next attempt will use a different codec.</string>
    <!-- The encoder started and then emitted nothing. Deliberately does not blame the codec: an
         encoder that produces nothing and a source that draws nothing are indistinguishable. -->
    <string name="cast_mirror_no_video_output">No video reached the TV. Try casting again.</string>

    <!-- Quick Settings tile -->
    <string name="cast_tile_label">Mirror screen</string>
    <string name="cast_tile_no_target">Choose a TV first</string>
    <string name="cast_tile_starting">Starting.</string>
    <string name="cast_tile_mirroring">Mirroring</string>

    <!-- Foreground service -->
    <string name="cast_notification_channel_name">Casting</string>
    <string name="cast_notification_channel_desc">Shown while a cast session is open</string>
    <string name="cast_notification_title">Casting to %1$s</string>
    <string name="cast_notification_text_connecting">Connecting</string>
    <string name="cast_notification_text_pairing">Waiting for the code on your TV</string>
    <string name="cast_notification_text_starting">Starting</string>
    <string name="cast_notification_text_failed">Could not start mirroring</string>

    <!-- The picker another app launches, and the permission it needs to. The permission's label and
         description are what the system shows in the app's permission list, so they have to read as
         something a user can decide about rather than as an API name. -->
    <string name="cast_stream_content_permission_label">Stream content to a television</string>
    <string name="cast_stream_content_permission_desc">Allows an app to send its own video and audio to a television you have paired with MA Cast, without pairing separately or seeing your network.</string>
    <string name="cast_picker_title">Cast %1$s to</string>
    <string name="cast_picker_title_generic">Choose a television</string>

    <!-- The secondary line on the row in Settings' Cast page. The primary line is the TV's own
         name, so this says what kind of thing it is rather than repeating it. -->
    <string name="cast_route_description">MA Cast receiver</string>
</resources>
