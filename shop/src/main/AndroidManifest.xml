<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- MAOS: opt out of the GrapheneOS Sensors permission (OTHER_SENSORS). -->
    <!-- This app uses no motion/environment sensors; MAOS withholds the -->
    <!-- Sensors permission at install instead of auto-granting it. -->
    <uses-permission android:name="com.vayunmathur.permission.SENSORS_OPTOUT" />

    <!-- Assistant tools (search / product / cart / orders) for openassistant.
         Signature-level: only apps signed with the Modern Apps key can call. -->
    <permission
        android:name="com.vayunmathur.shop.permissions.ACCESS_SHOP"
        android:protectionLevel="signature" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Delivery updates for placed orders (shipped, out for delivery, delivered). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Lets the embedded checkout's Payment Request find wallet apps such as Google Pay. -->
    <queries>
        <intent>
            <action android:name="org.chromium.intent.action.PAY" />
        </intent>
        <intent>
            <action android:name="org.chromium.intent.action.IS_READY_TO_PAY" />
        </intent>
        <intent>
            <action android:name="org.chromium.intent.action.UPDATE_PAYMENT_DETAILS" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.General">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.General">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Assistant checkout handoff: prepare-only, opens the cart;
                 checkout itself remains a one-tap user action in the app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="shop" android:host="cart" />
            </intent-filter>
        </activity>

        <activity
            android:name=".intents.SearchProductsIntent"
            android:exported="true"
            android:permission="com.vayunmathur.shop.permissions.ACCESS_SHOP"
            android:theme="@android:style/Theme.NoDisplay" />
        <activity
            android:name=".intents.GetProductIntent"
            android:exported="true"
            android:permission="com.vayunmathur.shop.permissions.ACCESS_SHOP"
            android:theme="@android:style/Theme.NoDisplay" />
        <activity
            android:name=".intents.GetCartIntent"
            android:exported="true"
            android:permission="com.vayunmathur.shop.permissions.ACCESS_SHOP"
            android:theme="@android:style/Theme.NoDisplay" />
        <activity
            android:name=".intents.AddToCartIntent"
            android:exported="true"
            android:permission="com.vayunmathur.shop.permissions.ACCESS_SHOP"
            android:theme="@android:style/Theme.NoDisplay" />
        <activity
            android:name=".intents.RemoveFromCartIntent"
            android:exported="true"
            android:permission="com.vayunmathur.shop.permissions.ACCESS_SHOP"
            android:theme="@android:style/Theme.NoDisplay" />
        <activity
            android:name=".intents.GetOrdersIntent"
            android:exported="true"
            android:permission="com.vayunmathur.shop.permissions.ACCESS_SHOP"
            android:theme="@android:style/Theme.NoDisplay" />
    </application>

</manifest>
