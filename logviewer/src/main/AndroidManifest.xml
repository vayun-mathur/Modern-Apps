<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- All five are kept from the app this replaces, and all five are load-bearing because we
         ship preinstalled in /system/priv-app rather than sideloaded. READ_LOGS_FULL,
         READ_OEM_UNLOCK_STATE and QUERY_USERS are signature|privileged, so each also needs an
         entry in vendor/modern-apps/privapp-permissions-modern-apps.xml - a missing entry there
         is a boot failure under ro.control_privapp_permissions=enforce, and a spurious one is
         equally fatal.

         READ_OEM_UNLOCK_STATE backs the "bootloader unlocked" flag and QUERY_USERS backs the
         "userType:" line in every report header; dropping either would silently change the output
         of the app we are replacing. -->
    <uses-permission android:name="android.permission.READ_LOGS" />
    <!-- tools:ignore because lint's SystemPermissionTypo check thinks this is a misspelling of
         READ_LOGS and offers to "correct" it. It is not: READ_LOGS_FULL is a real GrapheneOS
         permission that grants the unredacted log, and taking lint's suggestion would silently
         downgrade what every report contains. -->
    <uses-permission
        android:name="android.permission.READ_LOGS_FULL"
        tools:ignore="SystemPermissionTypo" />
    <uses-permission android:name="android.permission.READ_OEM_UNLOCK_STATE" />
    <!-- A log can be about ANY installed app, and both the uid to filter logcat on and the label in
         the title come from PackageManager. A <queries> list is not an option when the set of
         packages is "whichever one just crashed". -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.QUERY_USERS" />

    <!-- Renamed from app.grapheneos.logviewer.* but the protection levels are unchanged, because
         they are what makes the two entry points safe to export. `privileged` on the logcat side
         means only a priv-app can read the system log; `preinstalled` on the error-report side is
         looser on purpose, so a preinstalled app can show the user its own crash. -->
    <permission
        android:name="com.vayunmathur.logviewer.SHOW_LOGCAT"
        android:label="@string/permission_show_logcat_label"
        android:description="@string/permission_show_logcat_desc"
        android:protectionLevel="signature|privileged" />

    <permission
        android:name="com.vayunmathur.logviewer.SHOW_ERROR_REPORT"
        android:label="@string/permission_show_error_report_label"
        android:description="@string/permission_show_error_report_desc"
        android:protectionLevel="signature|preinstalled" />

    <!-- usesNonSdkApi is what makes platform/HiddenFrameworkApi.kt actually work, and without it
         that file is dead code. ApplicationInfo.isAllowedToUseHiddenApis() (framework source,
         ApplicationInfo.java:2646-2654) reads:
             if (isSignedWithPlatformKey())            return true;
             else if (isSystemApp() || isUpdatedSystemApp())
                                                       return usesNonSdkApi() || whitelisted;
             else                                      return false;
         We are a system app in /product/priv-app but signed with the Modern Apps release key, not
         the platform key - so the first branch is false and the second decides it. Without this
         attribute the policy is HIDDEN_API_ENFORCEMENT_ENABLED and every reflective lookup returns
         null forever, silently dropping the userType, package version and processUptime header
         fields that the app we replace prints.

         The alternative was a <hidden-api-whitelisted-app> entry in sysconfig-modern-apps.xml.
         This is the narrower of the two: it is self-declared in the app's own reviewable manifest,
         and it is inert for a non-system install (the branch above is only reached for a system
         app), where the reflection simply keeps degrading to omitted lines. -->
    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.General"
        android:usesNonSdkApi="true">

        <!-- Deliberately no MAIN/LAUNCHER activity. Both entry points are permission-guarded and
             reached from elsewhere - Settings, the system's crash dialog, or another priv-app - so
             a launcher entry would only offer an icon that cannot do anything on its own. -->
        <activity
            android:name=".intents.LogcatActivity"
            android:configChanges="mcc|mnc|colorMode|density|fontScale|fontWeightAdjustment|keyboard|keyboardHidden|layoutDirection|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:documentLaunchMode="always"
            android:exported="true"
            android:permission="com.vayunmathur.logviewer.SHOW_LOGCAT"
            android:theme="@style/Theme.General">
            <intent-filter>
                <action android:name="${applicationId}.LOGCAT" />
                <action android:name="${applicationId}.PKG_LOGCAT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".intents.ErrorReportActivity"
            android:configChanges="mcc|mnc|colorMode|density|fontScale|fontWeightAdjustment|keyboard|keyboardHidden|layoutDirection|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:documentLaunchMode="always"
            android:exported="true"
            android:permission="com.vayunmathur.logviewer.SHOW_ERROR_REPORT"
            android:theme="@style/Theme.General">
            <intent-filter>
                <action android:name="${applicationId}.ERROR_REPORT" />
                <action android:name="android.intent.action.APP_ERROR" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Serves a log snapshot to the share target as a content: Uri without ever writing it to
             storage. A file would have to be cleaned up and would briefly put the log somewhere
             another app could read; putting the bytes in the Intent instead would blow the binder
             transaction limit on any real log. -->
        <provider
            android:name=".provider.BlobProvider"
            android:authorities="${applicationId}.BlobProvider"
            android:exported="false"
            android:grantUriPermissions="true" />

    </application>
</manifest>
