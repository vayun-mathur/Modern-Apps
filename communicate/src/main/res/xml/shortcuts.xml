<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Direct Share (system share sheet's direct-share row). The category must
         match ConversationSpace.SHARE_TARGET_CATEGORY: dynamic conversation
         shortcuts carrying that category become chooser targets, and tapping
         one launches MainActivity with the ACTION_SEND / SEND_MULTIPLE intent
         (plus EXTRA_SHORTCUT_ID) declared in its intent-filters. -->
    <share-target android:targetClass="com.vayunmathur.communicate.MainActivity">
        <data android:mimeType="text/plain" />
        <data android:mimeType="image/*" />
        <data android:mimeType="video/*" />
        <data android:mimeType="application/*" />
        <category android:name="com.vayunmathur.communicate.category.DIRECT_SHARE" />
    </share-target>
</shortcuts>
