<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- MainActivity / Manifest: App name displayed in launcher. Noun, proper -->
    <string name="app_name" translatable="false">Pipes</string>
    <!-- PackScreen: TopAppBar title for pack selection screen. Noun phrase, entry point showing level packs grid -->
    <string name="pack_selector">Pack Select</string>
    <!-- LevelScreen: TopAppBar title for level grid inside a pack. Noun phrase -->
    <string name="level_selector">Level Select</string>
    <!-- SettingsScreen: Toggle label for colorblind accessibility mode. Noun phrase -->
    <string name="colorblind_mode">Colorblind mode</string>
    <!-- SettingsScreen: Subtitle explaining colorblind mode labels each flow with letter A-Z. Sentence -->
    <string name="colorblind_mode_desc">Label each flow with a letter (A–Z)</string>
    <!-- GameBoardScreen: Restart confirmation dialog title. Sentence, question -->
    <string name="restart_confirm_title">Restart level?</string>
    <!-- GameBoardScreen: Restart confirmation dialog message. Sentence -->
    <string name="restart_confirm_message">This will clear your current progress on this level.</string>
    <!-- GameBoardScreen: Message shown when the level is solved, with the number of moves used. Sentence, exclamation -->
    <plurals name="level_solved_moves">
        <item quantity="one">Solved in <xliff:g id="moves" example="1">%d</xliff:g> move!</item>
        <item quantity="other">Solved in <xliff:g id="moves" example="7">%d</xliff:g> moves!</item>
    </plurals>
    <!-- GameBoardScreen: Button shown after solving the last level of a pack; returns to the pack list. Verb phrase -->
    <string name="back_to_packs">Back to packs</string>
</resources>
