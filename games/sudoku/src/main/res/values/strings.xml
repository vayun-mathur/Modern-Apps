<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Manifest / HomeScreen TopAppBar: App name. Noun, proper -->
    <string name="app_name" translatable="false">Sudoku</string>

    <!-- HomeScreen: Label above the board size segmented buttons. Noun -->
    <string name="board_size">Board size</string>
    <!-- HomeScreen: Label above the difficulty segmented buttons. Noun -->
    <string name="difficulty">Difficulty</string>

    <!-- HomeScreen: Board size option, a 6 by 6 grid of 2x3 boxes. Noun, dimensions -->
    <string name="size_six" translatable="false">6x6</string>
    <!-- HomeScreen: Board size option, a 9 by 9 grid of 3x3 boxes. Noun, dimensions -->
    <string name="size_nine" translatable="false">9x9</string>
    <!-- HomeScreen: Board size option, a 12 by 12 grid of 3x4 boxes. Noun, dimensions -->
    <string name="size_twelve" translatable="false">12x12</string>

    <!-- HomeScreen: Title of the answer-mode setting row. Noun phrase -->
    <string name="answer_mode">Answer mode</string>
    <!-- HomeScreen: Explanation of answer mode under its title. Sentence -->
    <string name="answer_mode_description">Wrong digits are rejected and cost a life. Three strikes ends the puzzle.</string>
    <!-- HomeScreen: Title of the highlight-mistakes setting row. Noun phrase -->
    <string name="highlight_mistakes">Highlight mistakes</string>
    <!-- HomeScreen: Explanation of highlight mistakes under its title. Sentence -->
    <string name="highlight_mistakes_description">Wrong digits show in red as you play. Turn off for a harder game.</string>
    <!-- GameBoardScreen: Lives counter next to the hearts row, e.g. Lives: 2. Noun plural -->
    <string name="lives">Lives</string>
    <!-- GameOverOverlay: Title shown when answer mode runs out of lives. Declarative -->
    <string name="out_of_lives">Out of lives</string>
    <!-- GameOverOverlay: Explains the loss and offers another try. Sentence -->
    <string name="out_of_lives_message">Three wrong digits ended this puzzle. Try again?</string>
    <!-- GameOverOverlay: Starts a fresh puzzle with the same size and difficulty. Verb phrase -->
    <string name="try_again">Try Again</string>

    <!-- HomeScreen: Hardest difficulty, fewest clues given. Adjective -->
    <string name="difficulty_expert">Expert</string>

    <!-- GameBoardScreen action bar: Toggles whether taps write pencil marks. Noun used as a label -->
    <string name="notes">Notes</string>
    <!-- GameBoardScreen action bar: Fills one cell with its correct digit. Noun -->
    <string name="hint">Hint</string>
    <!-- GameBoardScreen action bar: Clears the selected cell. Verb -->
    <string name="erase">Erase</string>
    <!-- GameBoardScreen action bar: Abandons the puzzle, recorded as a loss. Verb phrase -->
    <string name="give_up">Give Up</string>
    <!-- GameBoardScreen give-up confirmation: Title asking whether to abandon the puzzle. Question -->
    <string name="confirm_give_up_title">Give up this puzzle?</string>
    <!-- GameBoardScreen give-up confirmation: Explains abandoning counts as a loss. Sentence -->
    <string name="confirm_give_up_message">Giving up counts as a loss and ends this puzzle.</string>
    <!-- GameBoardScreen TopAppBar: Label preceding the hint counter, e.g. Hints: 2. Noun plural -->
    <string name="hints_used">Hints</string>

    <!-- WinOverlay: Celebratory title shown when the grid is completed. Declarative -->
    <string name="congratulations">Congratulations!</string>
    <!-- WinOverlay: Celebratory title shown when the grid is completed. Declarative -->
    <!-- HomeScreen stat card: Label under the won-of-played ratio. Verb past participle -->
    <string name="won">won</string>

    <!-- GameBoardScreen: Content description of a single grid cell. %1$d = row number starting at 1, e.g. 3. %2$d = column number starting at 1, e.g. 7. %3$s = the digit showing or the word for empty, e.g. 5 -->
    <string name="cd_cell">Row <xliff:g id="row" example="3">%1$d</xliff:g>, column <xliff:g id="column" example="7">%2$d</xliff:g>, <xliff:g id="value" example="5">%3$s</xliff:g></string>
    <!-- NumberPad: Content description of a key that writes a digit. %1$s = the digit's symbol, e.g. 7 or B -->
    <string name="cd_digit_key">Enter <xliff:g id="digit" example="7">%1$s</xliff:g></string>
    <!-- NumberPad: Content description of a key that pencils a digit in, while notes mode is on. %1$s = the digit's symbol, e.g. 7 or B -->
    <string name="cd_note_key">Note <xliff:g id="digit" example="7">%1$s</xliff:g></string>
    <!-- GameBoardScreen: Spoken in place of a digit for a cell with nothing in it. Adjective -->
    <string name="cd_empty">empty</string>
    <!-- GameBoardScreen: Spoken state of a cell whose digit was printed by the puzzle and cannot be changed. Adjective -->
    <string name="cd_given">given</string>
    <!-- GameBoardScreen: Spoken state of a cell whose digit the player typed. Verb past participle -->
    <string name="cd_entered">entered</string>
    <!-- GameBoardScreen: Spoken state of an entered digit that disagrees with the solution, only while mistakes are highlighted. Adjective -->
    <string name="cd_wrong">incorrect</string>
    <!-- GameBoardScreen: Spoken state of a digit repeated in the same row, column or box. Phrase -->
    <string name="cd_conflict">repeated in row, column or box</string>
    <!-- GameBoardScreen: Spoken pencil marks in an empty cell. %1$s = the pencilled digits separated by spaces, e.g. 1 4 7 -->
    <string name="cd_notes">notes <xliff:g id="digits" example="1 4 7">%1$s</xliff:g></string>
</resources>
