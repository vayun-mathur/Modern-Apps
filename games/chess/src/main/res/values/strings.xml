    <string name="piece_white_queen">White Queen</string>
    <!-- ChessBoard: Accessibility description for white rook. Noun -->
    <string name="piece_white_rook">White Rook</string>
    <!-- ChessBoard: Accessibility description for white bishop. Noun -->
    <string name="piece_white_bishop">White Bishop</string>
