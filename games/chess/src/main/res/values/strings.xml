<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- MainActivity: App name displayed in TopAppBar and launcher. Noun, proper -->
    <string name="app_name">Chess</string>
    <!-- ChessGame / NewGameDialog: Dialog title when starting new Human vs AI game. Verb phrase -->
    <string name="start_new_game">Start New Game</string>
    <!-- NewGameDialog: Label before color chooser White/Black. Verb phrase, trailing spaces separate from chips -->
    <string name="play_as">"Play as    "</string>
    <!-- NewGameDialog: Color option White for player side. Noun/adjective -->
    <string name="color_white">White</string>
    <!-- NewGameDialog: Color option Black for player side. Noun/adjective -->
    <string name="color_black">Black</string>
    <!-- NewGameDialog: AI difficulty Master (hardest). Noun/adjective -->
    <string name="difficulty_master">Master</string>
    <!-- NewGameDialog: Confirm button to start AI game. Verb phrase CTA -->
    <string name="start_game">Start Game</string>
    <!-- MainActivity: Game mode option for two players on same device. Noun phrase -->
    <string name="two_player_local">2-Player Local</string>
    <!-- MainActivity: Game mode option Human vs AI. Noun phrase -->
    <string name="human_vs_ai">Human vs AI</string>
    <!-- PawnPromotionDialog / Learn / Puzzles: Title when pawn reaches last rank choose piece. Verb phrase -->
