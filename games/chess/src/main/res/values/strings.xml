    <string name="piece_black_bishop">Black Bishop</string>
    <!-- ChessBoard: Accessibility description for black knight. Noun -->
    <string name="piece_black_knight">Black Knight</string>
    <!-- ChessBoard: Accessibility description for black pawn. Noun -->
    <string name="piece_black_pawn">Black Pawn</string>
    <!-- ChessBoard: TalkBack label for an occupied square. %1$s = square in chess notation (e.g. e4), %2$s = piece (e.g. White Bishop). Noun phrase -->
    <string name="square_with_piece"><xliff:g id="square" example="e4">%1$s</xliff:g>, <xliff:g id="piece" example="White Bishop">%2$s</xliff:g></string>
    <!-- ChessBoard: TalkBack label for an empty square. %1$s = square in chess notation (e.g. e4). Noun phrase -->
    <string name="square_empty"><xliff:g id="square" example="e4">%1$s</xliff:g>, empty</string>
    <!-- ChessBoard: TalkBack state of a square the selected piece can move to. Short noun phrase, lowercase -->
    <string name="square_state_legal_move">legal move</string>
    <!-- ChessBoard: TalkBack state of an occupied square the selected piece can capture on. Short phrase, lowercase -->
    <string name="square_state_capture">can capture</string>
    <!-- ChessBoard: TalkBack state of a square that was part of the last move. Short noun phrase, lowercase -->
    <string name="square_state_last_move">last move</string>
    <!-- ChessBoard: TalkBack state of the square of a king that is in check. Short phrase, lowercase -->
    <string name="square_state_check">in check</string>
    <!-- ChessBoard: TalkBack double-tap action on a square holding a piece. Verb -->
    <string name="square_action_select">Select</string>
    <!-- ChessBoard: TalkBack double-tap action on a square the selected piece can move to. Verb phrase -->
    <string name="square_action_move_here">Move here</string>

    <!-- MainActivity: Bottom navigation tab for offline (local + AI) play. Noun phrase -->
    <string name="tab_offline">Offline Play</string>
    <!-- MainActivity: Bottom navigation tab for online (Lichess) play. Noun phrase -->
    <string name="tab_online">Online Play</string>
    <!-- MainActivity: Bottom navigation tab for Puzzles screen. Noun -->
    <string name="tab_puzzles">Puzzles</string>
    <!-- MainActivity: Bottom navigation tab for Learn lessons. Noun -->
    <string name="tab_learn">Learn</string>
    <!-- Learn: Stage intro dialog title. %1$d = stage id integer e.g. 1, %2$s = stage title e.g. Basics. Noun heading -->
    <string name="learn_stage_number">Stage <xliff:g id="stage_id" example="1">%1$d</xliff:g>: <xliff:g id="stage_title" example="Basics">%2$s</xliff:g></string>
    <!-- Learn: CTA button in stage intro to start lessons. Verb phrase -->
    <string name="learn_lets_go">Let\'s go!</string>
    <!-- Learn: Feedback text when lesson succeeded. Declarative, celebratory -->
    <string name="learn_completed">Well done!</string>
    <!-- Learn: StageCompleteDialog title. %1$d = stage id e.g. 2. Noun phrase -->
    <string name="learn_stage_complete_n">Stage <xliff:g id="stage_id" example="2">%1$d</xliff:g> complete</string>
    <!-- Learn: Score display in stage complete dialog. %1$d = score integer e.g. 350, includes apples, captures, bonus -->
    <string name="learn_your_score">Your score: <xliff:g id="score" example="350">%1$d</xliff:g></string>
    <!-- Learn: Button to go to next stage after completing. %1$s = next stage title e.g. Tactics. CTA -->
    <string name="learn_next_stage">Next: <xliff:g id="next_stage" example="Tactics">%1$s</xliff:g></string>
    <!-- Learn: Button back to main menu after stage complete. Verb phrase -->
    <string name="learn_back_to_menu">Back to menu</string>
    <!-- Learn: Progress indicator on stage card. %1$d = completed levels with star e.g. 3, %2$d = total levels e.g. 5. Status -->
    <string name="learn_progress"><xliff:g id="done" example="3">%1$d</xliff:g>/<xliff:g id="total" example="5">%2$d</xliff:g></string>
    <!-- Puzzles: Header showing puzzle rating. %1$d = Lichess rating integer e.g. 1200. Noun -->
    <string name="puzzle_rating">Rating <xliff:g id="rating" example="1200">%1$d</xliff:g></string>
    <!-- Puzzles: Instruction when puzzle starts, user to find best move. Sentence -->
    <string name="puzzle_your_move">Your turn — find the best move.</string>
    <!-- Puzzles: Turn indicator White to move. Declarative -->
    <string name="puzzle_white_to_move">White to move.</string>
    <!-- Puzzles: Turn indicator Black to move. Declarative -->
    <string name="puzzle_black_to_move">Black to move.</string>
    <!-- Puzzles: Status when puzzle solved correctly. Declarative -->
    <string name="puzzle_solved">Solved!</string>
    <!-- Puzzles: Status when puzzle failed. Sentence, encouraging retry -->
    <string name="puzzle_failed">Not quite — try again.</string>
    <!-- Puzzles: Button to load next random puzzle after solved. Verb phrase -->
    <string name="puzzle_next">Next Puzzle</string>
    <!-- Puzzles: Button to reveal solution after failing. Verb phrase -->
    <string name="puzzle_show_solution">Show Solution</string>
    <!-- Puzzles: Loading state while fetching puzzle. Verb progressive -->
    <string name="puzzle_loading">Loading puzzle…</string>

    <!-- Online: Sign-in CTA. Opens Lichess OAuth in a Custom Tab. Verb phrase -->
    <string name="online_sign_in">Sign in with Lichess</string>
    <!-- Online: Signed-in identity line. %1$s = Lichess username e.g. alice. Status -->
    <string name="online_signed_in_as">Signed in as <xliff:g id="username" example="alice">%1$s</xliff:g></string>
    <!-- Online: Sign-out button. Verb phrase -->
    <string name="online_sign_out">Sign out</string>
    <!-- Online: Lobby time-control option 1+0 (1 minute, no increment). Label -->
    <string name="online_tc_1_0">1+0</string>
    <!-- Online: Lobby time-control option 3+2. Label -->
    <string name="online_tc_3_2">3+2</string>
    <!-- Online: Lobby time-control option 5+3. Label -->
    <string name="online_tc_5_3">5+3</string>
    <!-- Online: Lobby time-control option 10+0. Label -->
    <string name="online_tc_10_0">10+0</string>
    <!-- Online: Quick Seek button, starts matchmaking with selected time control. Verb phrase CTA -->
    <string name="online_quick_seek">Quick Seek</string>
    <!-- Online: Seeking indicator while matchmaking. %1$s = time control e.g. 3+2. Verb progressive -->
    <string name="online_seeking">Seeking <xliff:g id="time_control" example="3+2">%1$s</xliff:g>…</string>
    <!-- Online: Username field label for challenge-by-username. Noun phrase -->
    <string name="online_challenge_username">Challenge by username</string>
    <!-- Online: Challenge button. Sends a game challenge to the typed username. Verb phrase CTA -->
    <string name="online_challenge">Challenge</string>
    <!-- Online: Confirmation after a challenge is sent. %1$s = opponent username e.g. alice. Sentence -->
    <string name="online_challenge_sent">Challenge sent to <xliff:g id="username" example="alice">%1$s</xliff:g>.</string>
    <!-- Online: Notice when the challenged player declines. Sentence -->
    <string name="online_challenge_declined">Challenge declined.</string>
    <!-- Online: Waiting for the Lichess approval to come back to the app. Verb progressive -->
    <string name="online_signing_in">Waiting for Lichess approval…</string>
    <!-- Online: You-resigned result line. Sentence -->
    <string name="online_result_resigned">You resigned.</string>
    <!-- Online: Opponent resigns result line. Sentence -->
    <string name="online_result_opponent_resigned">Opponent resigned. You win!</string>
    <!-- Online: Win result line. Sentence -->
    <string name="online_result_win">You win!</string>
    <!-- Online: Draw result line. Sentence -->
    <string name="online_result_draw">Draw.</string>
    <!-- Online: Loss result line. Sentence -->
    <string name="online_result_loss">You lose.</string>
    <!-- Online: Back-to-lobby button shown after a game ends. Verb phrase -->
    <string name="online_back_to_lobby">Back to lobby</string>
    <!-- Online: Resign confirm dialog title. Verb phrase -->
    <string name="online_resign_title">Resign this game?</string>
    <!-- Online: Resign confirm button. Verb -->
    <string name="online_resign_confirm">Resign</string>
    <!-- Online: Abort confirm dialog title. Shown before either side's first move. Verb phrase -->
    <string name="online_abort_title">Abort this game?</string>
    <!-- Online: Abort confirm button. Verb -->
    <string name="online_abort_confirm">Abort</string>
    <!-- Online: Connection banner while the game stream reconnects. Verb progressive -->
    <string name="online_reconnecting">Reconnecting…</string>
    <!-- Online: Error when the Lichess token expired (HTTP 401). Sentence -->
    <string name="online_auth_expired">Signed out by Lichess — please sign in again.</string>
    <!-- Online: Error when a seek or challenge fails. Sentence -->
    <string name="online_matchmaking_failed">Could not start a game. Try again.</string>
    <!-- Online: Error when sending a move fails. Sentence -->
    <string name="online_move_failed">Move not sent. Try again.</string>
    <!-- Online: Error when sign-in fails. Sentence -->
    <string name="online_sign_in_failed">Sign-in failed. Try again.</string>
    <!-- Online: Opponent label in game screen. %1$s = opponent username. Noun -->
    <string name="online_opponent"><xliff:g id="username" example="alice">%1$s</xliff:g></string>
</resources>
