<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Manifest / launcher: App name. Noun, proper, word puzzle game -->
    <string name="app_name" translatable="false">Word Maker</string>
    <!-- WordMakerViewModel: Error when parsing level data fails (CrosswordData.fromAsset null). Sentence -->
    <string name="error_parse_level">Failed to parse level data.</string>
    <!-- WordMakerTopBar: Title in casual mode when level number present. %1$d = level number integer, e.g. 12. Noun phrase -->
    <string name="level_number">Level <xliff:g id="level" example="12">%1$d</xliff:g></string>
    <!-- WordGameScreen: Accessibility label of the bonus words button (book icon, with a count badge) that opens the list of extra words found that are not in the puzzle. Noun phrase -->
    <string name="bonus_words">Bonus Words</string>
    <!-- BonusWordsDialog: Title of the dialog listing extra words found that are not in the puzzle; %1$d = how many have been found in this puzzle. Noun phrase -->
    <plurals name="bonus_words_title">
        <item quantity="one">Bonus Word (<xliff:g id="count" example="1">%1$d</xliff:g>)</item>
        <item quantity="other">Bonus Words (<xliff:g id="count" example="3">%1$d</xliff:g>)</item>
    </plurals>
    <!-- Settings: Toggle for tap-to-spell input mode. Label -->
    <string name="tap_to_spell">Tap to Spell</string>
    <!-- SettingsPage: Subtitle explaining tap-to-spell behavior. Sentence -->
    <string name="tap_to_spell_description">Tap letters to build words instead of dragging</string>
    <!-- SettingsPage: Label for the row choosing how far apart the letters sit on the wheel. Noun phrase -->
    <string name="wheel_spacing">Letter Wheel Spacing</string>
    <!-- SettingsPage: Letter wheel spacing option, the standard spacing. Adjective -->
    <string name="wheel_spacing_default">Default</string>
    <!-- SettingsPage: Letter wheel spacing option, letters further apart than default. Adjective -->
    <string name="wheel_spacing_wide">Wide</string>
    <!-- SettingsPage: Letter wheel spacing option, one step wider than Wide. Comparative adjective -->
    <string name="wheel_spacing_wider">Wider</string>
    <!-- SettingsPage: Letter wheel spacing option, the widest available. Superlative adjective -->
    <string name="wheel_spacing_widest">Widest</string>
    <!-- Hint confirmation dialog: Title asking confirm before using hint (consumes cooldown). Question sentence -->
    <string name="hint_confirmation">Are you sure you want to use a hint?</string>
    <!-- Hint confirmation dialog: Confirm button. Yes -->
    <string name="yes">Yes</string>
    <!-- Hint confirmation dialog: Dismiss button. No -->
    <string name="no">No</string>
    <!-- GameModeDropdown: Casual mode label. Noun/adjective -->
    <string name="mode_casual">Casual</string>
    <!-- GameModeDropdown: Competitive timed mode label. Adjective -->
    <string name="mode_competitive">Competitive</string>
    <!-- CompetitiveLobbyScreen / CompetitiveStatusBar: Score display. %1$d = current competitive score integer, e.g. 150. Noun with number -->
    <string name="competitive_score">Score: <xliff:g id="score" example="150">%1$d</xliff:g></string>
    <!-- CompetitiveLobbyScreen: Primary button before first game to start competitive. Verb -->
    <string name="competitive_start">Start</string>
    <!-- CompetitiveLobbyScreen: Label above difficulty dropdown. Noun -->
    <string name="competitive_difficulty">Difficulty</string>
    <!-- CompetitiveLobbyScreen: Info showing time limit per level for selected difficulty. %1$d = seconds e.g. 45. Noun phrase duration -->
    <string name="competitive_time_limit"><xliff:g id="seconds" example="45">%1$d</xliff:g> seconds per level</string>
    <!-- CompetitiveLobbyScreen: Result when level solved within time. %1$d = points delta e.g. 50 positive. Celebratory sentence -->
    <string name="competitive_solved">Solved! +<xliff:g id="points" example="50">%1$d</xliff:g> points</string>
    <!-- CompetitiveLobbyScreen: Result when timer expired. %1$d = points delta negative e.g. -15 or penalized, but displays as positive in string with context. Sentence -->
    <string name="competitive_timed_out">Time\'s up! <xliff:g id="points" example="-15">%1$d</xliff:g> points</string>

    <!-- GameModeDropdown: Daily challenge mode label. One date-seeded puzzle per day. Adjective -->
    <string name="mode_daily">Daily</string>
    <!-- DailyStatusBar: Consecutive days solved. %1$d = streak length e.g. 5. Noun phrase with number -->
    <string name="daily_streak"><xliff:g id="days" example="5">%1$d</xliff:g> day streak</string>
    <!-- WordGameScreen: Shown after solving the daily, in place of the Next Level button. Sentence -->
    <string name="daily_come_back_tomorrow">Solved! Come back tomorrow.</string>

    <!-- LetterChooser: Accessibility content description for shuffle button that randomizes letter order. Verb -->
    <string name="cd_shuffle">Shuffle</string>
    <!-- WordGameScreen: Accessibility description for hint button (help icon) that reveals a letter with 30s cooldown indicator. Noun -->
    <string name="cd_hint">Hint</string>
    <!-- WordGameScreen tap mode: Accessibility description for submit button (return icon) to submit formed word. Verb -->
    <string name="cd_submit">Submit</string>
    <!-- WordGameScreen tap mode: Accessibility description for backspace button to delete last selected letter. Noun -->
    <string name="cd_backspace">Backspace</string>

    <!-- DefinitionDialog: Body shown when the bundled dictionary has no entry for the tapped word. Sentence -->
    <string name="no_definition_available">No definition available for this word.</string>
</resources>
