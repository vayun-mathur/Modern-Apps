<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Manifest / TopAppBar: App name. Noun, proper -->
    <string name="app_name" translatable="false">Nonogram</string>

    <!-- GameModeDropdown: Mode playing the numbered level progression. Adjective -->
    <string name="mode_casual">Levels</string>
    <!-- GameModeDropdown: Mode playing today's shared puzzle. Adjective -->
    <string name="mode_daily">Daily</string>

    <!-- NonogramGameScreen TopAppBar: Current level in the progression. %1$d = level number, e.g. 12 -->
    <string name="level_title">Level <xliff:g id="level" example="12">%1$d</xliff:g></string>
    <!-- NonogramGameScreen restart confirmation: Title asking whether to clear the board's marks. Question -->
    <string name="confirm_restart_title">Restart this puzzle?</string>
    <!-- NonogramGameScreen restart confirmation: Explains every mark is cleared. Sentence -->
    <string name="confirm_restart_message">All your marks on this puzzle will be cleared.</string>
    <!-- NonogramGameScreen: Shown after finishing the daily, since there is only one per day. Sentence -->
    <string name="daily_come_back_tomorrow">Solved! Come back tomorrow for a new puzzle.</string>
    <!-- NonogramGameScreen: Celebratory line shown when a level is completed. Declarative -->
    <string name="solved">Solved!</string>
    <!-- NonogramGameScreen: Shown after clearing the daily, since there is only one per day. Sentence -->
    <!-- NonogramGameScreen: Hint under a fresh board in Fill mode, explaining the gestures. Imperative sentence -->
    <string name="how_to_play_fill">Tap or drag to fill, long press to cross out</string>
    <!-- NonogramGameScreen: Hint under a fresh board in Cross mode, explaining the gestures. Imperative sentence -->
    <string name="how_to_play_cross">Tap or drag to cross out, long press to fill</string>
    <!-- MarkModeToggle: Tap places part of the picture. Verb, imperative -->
    <string name="mode_fill">Fill</string>
    <!-- MarkModeToggle: Tap crosses a cell off as empty. Verb, imperative -->
    <string name="mode_cross">Cross</string>
    <!-- NonogramGameScreen: Shown when the last heart is spent. Declarative, sympathetic -->
    <string name="out_of_hearts">Out of hearts!</string>

    <!-- NonogramGameScreen: Shown when no fair puzzle could be generated for this level. Sentence -->
    <string name="generation_failed">Could not build a puzzle for this level.</string>
    <!-- NonogramGameScreen: Retries generation after a failure, and the level after running out of hearts. Verb -->
    <string name="try_again">Try Again</string>

    <!-- NonogramBoard: Content description of a cell; TalkBack reads its state after it. %1$d = row number starting at 1, e.g. 4. %2$d = column number starting at 1, e.g. 6 -->
    <string name="cd_cell_position">Row <xliff:g id="row" example="4">%1$d</xliff:g>, column <xliff:g id="column" example="6">%2$d</xliff:g></string>
    <!-- NonogramBoard: TalkBack action that fills a cell as part of the picture. Verb, imperative -->
    <string name="action_fill">Fill</string>
    <!-- NonogramBoard: TalkBack action that marks a cell as empty with an X. Verb phrase, imperative -->
    <string name="action_cross">Cross out</string>
    <!-- NonogramBoard: TalkBack action that removes the player's own X from a cell. Verb phrase, imperative -->
    <string name="action_uncross">Remove cross</string>
    <!-- NonogramBoard: Cell state, painted as part of the picture. Verb past participle -->
    <string name="cd_filled">Filled</string>
    <!-- NonogramBoard: Cell state, ruled out by the player. Verb past participle -->
    <string name="cd_crossed">Crossed out</string>
    <!-- NonogramBoard: Cell state, shown empty by the game after a wrong guess cost a heart. Adjective phrase -->
    <string name="cd_revealed">Empty, revealed by a mistake</string>
    <!-- NonogramBoard: Cell state, untouched. Adjective -->
    <string name="cd_blank">Blank</string>
</resources>
