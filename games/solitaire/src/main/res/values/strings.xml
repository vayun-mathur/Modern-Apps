    <string name="klondike">Klondike</string>
    <!-- MainActivity: Game mode name Spider (8 suits). Noun, proper -->
    <string name="spider">Spider</string>
    <!-- MainActivity: Game mode name FreeCell. Noun, proper -->
    <string name="freecell">FreeCell</string>
    <!-- MainActivity: Game mode name Pyramid (pair to 13). Noun, proper -->
    <string name="pyramid">Pyramid</string>
