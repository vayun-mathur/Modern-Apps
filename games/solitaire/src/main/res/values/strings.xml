    <!-- GameScreen TopAppBar / WinOverlay: Label for move counter HUD. Noun -->
    <string name="moves">Moves</string>
    <!-- MainActivity: Klondike draw mode option 1 card. Noun phrase -->
    <string name="draw_one">Draw 1</string>
    <!-- MainActivity: Klondike draw mode option 3 cards. Noun phrase -->
    <string name="draw_three">Draw 3</string>
    <!-- WinOverlay: Title when player wins, celebratory, large bold primary colored. Declarative -->
    <string name="congratulations">Congratulations!</string>
    <!-- MainActivity: Title of initial mode-picker AlertDialog listing GameMode.entries. Verb phrase -->
    <string name="select_mode">Select Mode</string>
    <!-- MainActivity: Pyramid mode option original single pass through stock. Noun/adjective -->
    <string name="mode_original">Original</string>
    <!-- MainActivity: Mode option relaxed unlimited redeals. Klondike and Pyramid. Adjective -->
    <string name="mode_relaxed">Relaxed</string>
    <!-- MainActivity: Klondike regular difficulty 2 redeals (3 passes). Adjective -->
    <string name="difficulty_regular">Regular</string>

