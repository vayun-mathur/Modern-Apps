<?xml version="1.0" encoding="utf-8"?>
<!-- Overrides the permissive default in the shared :library module.

     Storage audited:
       database/passwords-db  AppDatabase (Conversation/Message/Memory): the full
                              conversation history plus remembered facts. Free-form user
                              text, so it can contain anything.
       external/              on-demand model downloads in getExternalFilesDir(null):
                              the gemma4/ maml model files. Gigabytes, and re-downloadable.
       file/datastore_default.preferences_pb  model download progress and version markers
                              (progress_*, dlid_*). Meaningless once
                              the models are gone.
       cache/                 recordings and attachment scratch files; Android never backs
                              up cacheDir.
       sharedpref/secure_prefs  keystore-wrapped SQLCipher passphrase.

     No API keys or remote credentials were found - inference runs on-device - so the only
     secret-grade material is the keystore passphrase.

     These rules now govern cloud backup too: the legacy android:backupAgent was removed.
     It exported the conversation history DECRYPTED via SqlCipherDbCodec, bypassing the
     <cloud-backup> denials below. (Its "passwords-db" name was the shared RoomRepository
     default file name, not a distinct passwords database.) Cloud stays deny-all: the
     models are gigabytes and re-downloadable, and the download markers are meaningless
     without them. <device-transfer> carries the history and nothing else. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Whole-domain include so the -wal/-shm sidecars travel with the database. -->
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
