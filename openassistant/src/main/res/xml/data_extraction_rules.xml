<?xml version="1.0" encoding="utf-8"?>
<!-- Overrides the permissive default in the shared :library module.

     Storage audited:
       database/passwords-db  AppDatabase (Conversation/Message/Memory): the full
                              conversation history plus remembered facts. Free-form user
                              text, so it can contain anything.
       external/              on-demand model downloads in getExternalFilesDir(null):
                              the gemma4/ maml model files, the SigLIP2 ONNX encoders and
                              tokenizer.model. Gigabytes, and re-downloadable.
       file/datastore_default.preferences_pb  model download progress and version markers
                              (progress_*, dlid_*, siglip_model_version). Meaningless once
                              the models are gone.
       cache/                 recordings and attachment scratch files; Android never backs
                              up cacheDir.
       sharedpref/secure_prefs  keystore-wrapped SQLCipher passphrase.

     No API keys or remote credentials were found - inference runs on-device - so the only
     secret-grade material is the keystore passphrase.

     SCOPE: openassistant declares android:backupAgent=".util.AppBackupAgent" and does NOT set
     android:fullBackupOnly, so cloud backup runs through the agent and the <cloud-backup>
     section below is NOT consulted. What actually reaches the cloud is the agent's
     dbConfigs = ["passwords-db"], i.e. the conversation history, exported decrypted by
     SqlCipherDbCodec. That is deliberate: losing a new phone's whole assistant history is
     worse than the exposure, and the history is the only thing here that is not
     regenerable. The <cloud-backup> denials below are kept as the policy that applies if
     the agent is ever removed and Auto Backup takes over: the models are gigabytes and
     re-downloadable, and the download markers are meaningless without them.
     <device-transfer> IS governed here and carries the history and nothing else. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Whole-domain include so the -wal/-shm sidecars travel with the database. -->
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
