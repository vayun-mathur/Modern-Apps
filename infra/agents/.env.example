# agentd environment (/root/agent-world/.env on the host).
# Copy to /root/agent-world/.env and fill in secrets. Never commit the file.
# Consumed via `env_file` by the agentd service only (builder/sandbox gets
# no secrets).

# OpenRouter API key for the coding model.
OPENROUTER_API_KEY=
# Argon2 PHC hash of the UI password (generate with e.g.
# `python3 -c "import argon2..."` or `mkpasswd --method=argon2id`).
AGENTD_PASSWORD_HASH=
# Git push token for the git.maproj.org mirror (agent branches push here).
GIT_AGENT_PUSH_TOKEN=
# Mirror origin for agent branches.
AGENTD_REPO_URL=https://git.maproj.org/Modern-Apps.git
# Public origin served by Caddy (agents.maproj.org -> agents-ui:8080).
AGENTD_PUBLIC_ORIGIN=https://agents.maproj.org
# Default model for coding turns.
AGENTD_DEFAULT_MODEL=
# GitHub token (agentd only, never the sandbox): reads issues, and on Approve
# / triage comments and edits labels. Needs Issues read/write on the repo.
AGENTD_GITHUB_TOKEN=
# Repo for issues (default vayun-mathur/Modern-Apps).
AGENTD_GITHUB_REPO=
# Automatic triage of NEW issues (no backfill): 0 disables; poll interval.
AGENTD_TRIAGE=1
AGENTD_TRIAGE_INTERVAL_SECS=120
