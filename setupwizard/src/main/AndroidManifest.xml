<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="ProtectedPermissions">

    <!-- MAOS: opt out of the GrapheneOS Sensors permission (OTHER_SENSORS). -->
    <!-- This app uses no motion/environment sensors; MAOS withholds the -->
    <!-- Sensors permission at install instead of auto-granting it. -->
    <uses-permission android:name="com.vayunmathur.permission.SENSORS_OPTOUT" />

    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_CONFIGURATION" />
    <uses-permission android:name="android.permission.MANAGE_USER_OEM_UNLOCK_STATE" />
    <uses-permission android:name="android.permission.NETWORK_SETUP_WIZARD" />
    <uses-permission android:name="android.permission.READ_PRIVILEGED_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_OEM_UNLOCK_STATE" />
    <uses-permission android:name="android.permission.REBOOT" />
    <uses-permission android:name="android.permission.STATUS_BAR" />
    <!--
      AUTO_TIME and AUTO_TIME_ZONE are Settings.Global, which is gated on WRITE_SECURE_SETTINGS
      rather than WRITE_SETTINGS. SET_TIME / SET_TIME_ZONE are deliberately NOT requested: the
      wizard turns the automatic clock on and never sets a time itself.
    -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!--
      The gesture tutorial, the Wi-Fi and lock-screen setup flows and the restore flow all live
      in other packages and are reached by implicit intent. Package visibility filtering would
      otherwise hide them from resolveActivity, and the steps that probe before launching would
      all conclude they are unavailable.
    -->
    <queries>
        <intent>
            <action android:name="android.settings.SETUP_INTERNET" />
        </intent>
        <intent>
            <action android:name="android.settings.BIOMETRIC_ENROLL" />
        </intent>
        <intent>
            <action android:name="android.settings.ACCESSIBILITY_SETTINGS_FOR_SUW" />
        </intent>
        <intent>
            <action android:name="com.android.quickstep.action.GESTURE_SANDBOX" />
        </intent>
        <intent>
            <action android:name="com.vayunmathur.backup.RESTORE_BACKUP" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.General">

        <!--
          BOOT-CRITICAL. The platform picks the setup wizard by resolving MAIN against the
          SETUP_WIZARD and HOME categories; priority 999 is what wins that resolution over
          AOSP's Provision and over the real launcher while the device is unprovisioned. If
          this filter is wrong there is no HOME activity during provisioning and the device
          does not get past first boot.

          android:name is written out in full rather than as ".MainActivity" because the
          same string is the one privapp-permissions and KnownSystemPackages are matched
          against by hand, and a relative name hides that.
        -->
        <activity
            android:configChanges="mcc|mnc|colorMode|density|fontScale|fontWeightAdjustment|keyboard|keyboardHidden|layoutDirection|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:name="com.vayunmathur.setupwizard.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.General">
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.SETUP_WIZARD" />
                <category android:name="android.intent.category.HOME" />
            </intent-filter>
        </activity>
    </application>

</manifest>
