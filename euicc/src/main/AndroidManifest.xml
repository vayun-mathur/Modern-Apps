<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- MAOS: opt out of the GrapheneOS Sensors permission (OTHER_SENSORS). -->
    <!-- This app uses no motion/environment sensors; MAOS withholds the -->
    <!-- Sensors permission at install instead of auto-granting it. -->
    <uses-permission android:name="com.vayunmathur.permission.SENSORS_OPTOUT" />

    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.MODIFY_PHONE_STATE" />
    <uses-permission android:name="android.permission.WRITE_EMBEDDED_SUBSCRIPTIONS" />
    <uses-permission android:name="android.permission.READ_PRIVILEGED_PHONE_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.General">
        <!--
          **No launcher activity, deliberately.** eSIMs are managed from Settings' own SIM screens,
          which reach this app through [LuiActivity] below - the component the platform resolves.
          A second icon in the launcher opened the same screen by a route nothing else uses, and an
          eSIM manager is not an app a user goes looking for by name.

          `MainActivity` existed only to carry that icon and has been removed with it; LuiActivity
          shows the same `Navigation` composable and is reachable, which MainActivity would not
          have been.
        -->

        <!--
          The LUI the platform opens from Settings. Guarded by BIND_EUICC_SERVICE because
          EuiccConnector.isValidEuiccComponent applies that requirement to the resolving
          activity, not just to the EuiccService - without it the platform finds no LUI and
          the Settings row silently does nothing. It cannot live on MainActivity, since
          android:permission constrains the caller and the launcher holds no signature
          permission. See LuiActivity.
        -->
        <activity
            android:configChanges="mcc|mnc|colorMode|density|fontScale|fontWeightAdjustment|keyboard|keyboardHidden|layoutDirection|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:name=".platform.LuiActivity"
            android:exported="true"
            android:permission="android.permission.BIND_EUICC_SERVICE"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.General">
            <intent-filter android:priority="100">
                <action android:name="android.service.euicc.action.MANAGE_EMBEDDED_SUBSCRIPTIONS" />
                <action android:name="android.service.euicc.action.PROVISION_EMBEDDED_SUBSCRIPTION" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.service.euicc.category.EUICC_UI" />
            </intent-filter>
        </activity>

        <!--
          Standard eSIM universal link handler:
          https://esimsetup.android.com/esim_qrcode_provisioning?carddata=<code>.
          Scanners fire ACTION_VIEW on this URL and the LPA declaring the host+path
          receives it instead of a browser. Deliberately NOT gated by
          BIND_EUICC_SERVICE: that permission constrains the caller, and a
          third-party app holds no signature permission, so gating this would make
          the handoff unopenable. It carries no eUICC capability itself — it only
          seeds the normal AddSim/Download flow, which needs no privilege to
          display and fails gracefully where there is no eUICC.
        -->
        <activity
            android:configChanges="mcc|mnc|colorMode|density|fontScale|fontWeightAdjustment|keyboard|keyboardHidden|layoutDirection|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:name=".platform.AddEsimActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.General">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="esimsetup.android.com"
                    android:path="/esim_qrcode_provisioning" />
            </intent-filter>
            <!-- Raw `lpa:` activation-code deep link alongside the universal link. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="lpa" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.EuiccManagerService"
            android:exported="true"
            android:permission="android.permission.BIND_EUICC_SERVICE">
            <intent-filter android:priority="100">
                <action android:name="android.service.euicc.EuiccService" />
            </intent-filter>
        </service>

        <!--
          Foreground lifetime guard for the BPP install phase (shortService:
          no extra permission beyond FOREGROUND_SERVICE, ~3 min budget, which
          covers a profile install; the wake lock has its own 10-min backstop).
          Started by EuiccViewModel around nativeFinishDownload, never exported.
        -->
        <service
            android:name=".service.DownloadService"
            android:exported="false"
            android:foregroundServiceType="shortService" />
    </application>

</manifest>
