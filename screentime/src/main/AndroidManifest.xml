<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!--
      Everything this app holds arrives with the SYSTEM_WELLBEING role, which the platform
      grants to whichever package `config_systemWellbeing` names - see the pin in
      vendor/modern-apps/rro/MaosFrameworkResRRO/res/values/config.xml. The role grants
      SUSPEND_APPS, SYSTEM_APPLICATION_OVERLAY and OBSERVE_APP_USAGE (all
      signature|privileged|role or signature|role), which is why those three are declared
      without apology below: a role grants only what the manifest requests.

      Neither belongs in privapp-permissions-modern-apps.xml. This app is not a priv-app, and
      an entry there that does not match the manifest is boot-fatal under
      ro.control_privapp_permissions=enforce.
    -->
    <!-- Pauses apps whose timer ran out or that focus mode covers. Arrives via the role. -->
    <!-- MAOS: opt out of the GrapheneOS Sensors permission (OTHER_SENSORS). -->
    <!-- This app uses no motion/environment sensors; MAOS withholds the -->
    <!-- Sensors permission at install instead of auto-granting it. -->
    <uses-permission android:name="com.vayunmathur.permission.SENSORS_OPTOUT" />

    <uses-permission android:name="android.permission.SUSPEND_APPS" />
    <!-- Friction sheets and the expired-timer screen draw over the opening app. Via the role. -->
    <uses-permission android:name="android.permission.SYSTEM_APPLICATION_OVERLAY" />
    <!-- Time-based callbacks when an app reaches a usage threshold. Via the role. -->
    <uses-permission android:name="android.permission.OBSERVE_APP_USAGE" />
    <!-- Reads per-app foreground time for the dashboard. An appop, not a role grant: declared
         here but stays denied until granted in Settings or self-granted - see UsageAccess. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Lets UsageAccess set the usage-stats app-op on our own uid. Declared like parental
         controls does; the role grant supplies the privilege. -->
    <uses-permission android:name="android.permission.MANAGE_APP_OPS_MODES"
        tools:ignore="ProtectedPermissions" />
    <!-- The wind-down schedule arms exact alarms for window edges. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Re-arms schedules and observers after a restart. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- The dashboard and pickers list launchable apps. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Timer/friction notices. A normal runtime permission. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Wind-down couples to Do Not Disturb. Normal permission; the user grants the
         policy access once in Settings, after which the schedule toggles it directly. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- Not requested, deliberately: no INTERNET. Usage stays on the device - the dashboard,
         timers, pauses and bedtime are all local, and there is no account to sync to. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.General">
        <!--
          The dashboard. Reached from Settings only - no launcher icon. The intent-filter
          below registers the activity as a Settings row (ia.homepage + summary), so
          Settings > Digital Wellbeing and search land on the dashboard alongside
          Wind Down. Stock Wellbeing spreads its rows across homepage/apps/gestures/bedtime
          with summary URIs; ours registers the same homepage rows against our own activities.
        -->
        <activity
            android:name=".ui.DashboardActivity"
            android:configChanges="mcc|mnc|colorMode|density|fontScale|fontWeightAdjustment|keyboard|keyboardHidden|layoutDirection|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.General">
            <intent-filter>
                <action android:name="com.vayunmathur.screentime.action.DASHBOARD" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.homepage" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/dashboard_summary" />
        </activity>

        <!--
          Settings rows. Stock Wellbeing spreads these across the homepage, apps, gestures and
          bedtime categories with summary URIs; ours registers the same rows against our own
          activities so Settings > Digital Wellbeing (and search) lands here.
        -->
        <activity
            android:name=".ui.WindDownActivity"
            android:configChanges="mcc|mnc|colorMode|density|fontScale|fontWeightAdjustment|keyboard|keyboardHidden|layoutDirection|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:exported="true"
            android:label="@string/winddown_title"
            android:theme="@style/Theme.General">
            <intent-filter>
                <action android:name="android.settings.BEDTIME_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.homepage" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/winddown_summary" />
        </activity>

        <activity
            android:name=".ui.AppDetailsActivity"
            android:configChanges="mcc|mnc|colorMode|density|fontScale|fontWeightAdjustment|keyboard|keyboardHidden|layoutDirection|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:exported="true"
            android:label="@string/details_title"
            android:theme="@style/Theme.General">
            <intent-filter>
                <action android:name="com.vayunmathur.screentime.action.APP_DETAILS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          Friction sheets and the expired-timer notice. Started explicitly by our own
          receivers and the usage-observer path; never exported, never in the launcher.
          showWhenLocked is set in code so the sheet meets the launch, not the home screen.
        -->
        <activity
            android:name=".ui.FrictionActivity"
            android:configChanges="mcc|mnc|colorMode|density|fontScale|fontWeightAdjustment|keyboard|keyboardHidden|layoutDirection|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:theme="@style/Theme.General" />

        <!-- Fired by UsageStatsService when an app spends its timer budget. -->
        <receiver
            android:name=".receiver.TimerReachedReceiver"
            android:exported="false" />

        <!-- Wind-down window edges. Re-armed each time one fires. -->
        <receiver
            android:name=".receiver.ScheduleReceiver"
            android:exported="false" />

        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widget.ScreenTimeGlanceWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_description">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/screentime_widget_info" />
        </receiver>
    </application>
</manifest>
